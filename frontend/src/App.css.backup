/* Import Agency FB Font */
@import url('https://fonts.googleapis.com/css2?family=Agency+FB:wght@400;700&display=swap');

/* CSS Reset and Performance Optimizations */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Smooth scroll optimization */
html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Remove excessive GPU layers - apply only where needed */

/* Thai Spa Styles */
:root {
  --spa-dark: #0a0a0a;
  --spa-gold: #d4af37;
  --spa-gold-light: #f4e676;
  --spa-gold-dark: #b8941f;
  --spa-bronze: #cd7f32;
  --spa-cream: #f5f2e8;
  --spa-warm: #2a1810;
  --spa-accent: #8b4513;
}

.bg-spa-dark {
  background: linear-gradient(135deg, var(--spa-dark) 0%, #1a1a1a 100%);
  min-height: 100vh;
}

/* Parallax Background */
.parallax-container {
  position: relative;
  overflow: hidden;
}

.parallax-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background: linear-gradient(135deg, var(--spa-dark) 0%, #1a1a1a 100%);
  background-image: url('https://customer-assets.emergentagent.com/job_83ed575e-3634-46be-8586-79a3348def97/artifacts/i03j5uou_podloga.jpg');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  opacity: 0.15;
  z-index: -2;
  will-change: transform;
}

.parallax-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background: linear-gradient(135deg, rgba(10, 10, 10, 0.9) 0%, rgba(26, 26, 26, 0.8) 100%);
  z-index: -1;
}

/* Compact Logo Section with Background */
.logo-section {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 1rem 0;
  background-image: url('https://customer-assets.emergentagent.com/job_serene-retreat-1/artifacts/zft4r2iu_podloga.jpg');
  background-size: cover;
  background-position: center;
  border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  position: relative;
  z-index: 100;
  min-height: 80px;
}

.logo-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1;
}

.logo-image {
  max-height: 500px;
  width: auto;
  filter: drop-shadow(0 5px 15px rgba(0, 0, 0, 0.8));
  transition: transform 0.3s ease, filter 0.3s ease;
  animation: gentle-glow 3s ease-in-out infinite alternate;
  transform: scale(1.0);
  position: relative;
  z-index: 2;
}

.logo-image:hover {
  transform: scale(1.05);
  filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.9));
}

@keyframes gentle-glow {
  0% { 
    filter: drop-shadow(0 0 30px rgba(212, 175, 55, 0.5));
    transform: scale(1.1);
  }
  100% { 
    filter: drop-shadow(0 0 40px rgba(212, 175, 55, 0.7));
    transform: scale(1.12);
  }
}

/* Fixed Footer with Slogan Below Buddha */
/* Thin footer bar below header */
.thin-footer-header {
  position: fixed;
  top: 143px; /* Below header */
  left: 0;
  right: 0;
  width: 100%;
  height: 25px;
  z-index: 999;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(15px);
  border-bottom: 1px solid rgba(212, 175, 55, 0.3);
}

/* Transparent footer bar - both above and below Buddha */
.transparent-footer-bar {
  display: none;
}

.fixed-footer-slogan {
  display: none;
}

.fixed-footer-content {
  display: none;
}

.fixed-footer-text {
  display: none;
}

@keyframes goldGlow {
  0% { 
    text-shadow: 2px 2px 4px rgba(0,0,0,0.8), 0 0 20px rgba(212, 175, 55, 0.3);
  }
  100% { 
    text-shadow: 2px 2px 4px rgba(0,0,0,0.8), 0 0 30px rgba(212, 175, 55, 0.6);
  }
}

/* Fixed Navigation with Logo */
.header-container {
  background-image: url('https://customer-assets.emergentagent.com/job_serene-retreat-1/artifacts/qh0x1l26_Pozadina%201.jpg');
  background-size: cover;
  background-position: center;
  position: relative;
  backdrop-filter: blur(15px);
  border-bottom: 2px solid var(--spa-gold);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  transition: all 0.3s ease;
  box-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
}

.header-container .nav-logo-container {
  position: fixed;
  left: 0.5rem;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1001;
}

.header-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: -1;
}

.header-container::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--spa-gold);
  z-index: 10;
}

.nav-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.5rem 2rem;
  max-width: 1400px;
  margin: 0 auto;
}

/* Logo in Navigation */
.nav-logo-container {
  z-index: 10;
}

.nav-logo {
  height: 70px;
  width: auto;
  filter: drop-shadow(0 3px 10px rgba(0, 0, 0, 0.7));
  transition: all 0.3s ease;
}

.nav-logo:hover {
  transform: scale(1.05);
  filter: drop-shadow(0 5px 15px rgba(0, 0, 0, 0.9));
}

.nav-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 1rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
}

.nav-desktop {
  display: flex;
  gap: 2rem;
  flex: 1;
  justify-content: flex-end;
  margin-right: 2rem;
}

.nav-link {
  color: var(--spa-cream);
  text-decoration: none;
  font-weight: 600;
  font-size: 1.2rem;
  letter-spacing: 1px;
  position: relative;
  padding: 0.5rem 1rem;
  transition: all 0.3s ease;
  border-radius: 4px;
  font-family: 'Agency FB', 'Arial Narrow', sans-serif;
}

.nav-link:hover {
  color: var(--spa-gold);
  background: rgba(212, 175, 55, 0.1);
  transform: translateY(-2px);
}

.nav-link-active {
  color: var(--spa-gold);
  background: rgba(212, 175, 55, 0.2);
}

.nav-link::after {
  content: '';
  position: absolute;
  width: 0;
  height: 2px;
  bottom: 0;
  left: 50%;
  background: var(--spa-gold);
  transition: all 0.3s ease;
}

.nav-link:hover::after,
.nav-link-active::after {
  width: 100%;
  left: 0;
}

.language-selector {
  display: flex;
  align-items: center;
}

.language-button {
  color: var(--spa-cream);
  border: 1px solid var(--spa-gold);
  background: transparent;
  transition: all 0.3s ease;
}

.language-button:hover {
  background: var(--spa-gold);
  color: var(--spa-dark);
}

/* Language Dropdown Menu Styling */
.language-dropdown-custom {
  background: linear-gradient(135deg, rgba(15, 15, 20, 0.98), rgba(30, 25, 20, 0.98)) !important;
  border: 2px solid var(--spa-gold) !important;
  border-radius: 10px !important;
  padding: 0.75rem 0 !important;
  box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4), 
              0 0 0 1px rgba(212, 175, 55, 0.2),
              inset 0 1px 0 rgba(212, 175, 55, 0.1) !important;
  backdrop-filter: blur(12px) !important;
  min-width: 160px !important;
  margin-top: 0.5rem !important;
}

.language-dropdown-custom [role="menuitem"],
.language-dropdown-custom > div {
  color: var(--spa-cream) !important;
  padding: 0.75rem 1.25rem !important;
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 0.975rem;
  font-weight: 400;
  border-left: 3px solid transparent;
  background: transparent !important;
}

.language-dropdown-custom [role="menuitem"]:hover,
.language-dropdown-custom > div:hover {
  background: rgba(212, 175, 55, 0.2) !important;
  border-left-color: var(--spa-gold);
  padding-left: 1.5rem !important;
  color: var(--spa-gold) !important;
}

.language-dropdown-custom [role="menuitem"][data-highlighted],
.language-dropdown-custom > div[data-highlighted] {
  background: rgba(212, 175, 55, 0.2) !important;
  border-left-color: var(--spa-gold);
  outline: none;
}

.language-dropdown-custom .bg-accent {
  background: rgba(212, 175, 55, 0.3) !important;
  border-left-color: var(--spa-gold);
  border-left-width: 3px;
  color: var(--spa-gold) !important;
  font-weight: 600;
}

/* Mobile Menu */
.mobile-menu-button {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.5rem;
}

.hamburger {
  width: 24px;
  height: 18px;
  position: relative;
  cursor: pointer;
}

.hamburger span {
  display: block;
  position: absolute;
  height: 2px;
  width: 100%;
  background: var(--spa-gold);
  border-radius: 1px;
  opacity: 1;
  left: 0;
  transform: rotate(0deg);
  transition: 0.25s ease-in-out;
}

.hamburger span:nth-child(1) { top: 0px; }
.hamburger span:nth-child(2) { top: 8px; }
.hamburger span:nth-child(3) { top: 16px; }

.hamburger.active span:nth-child(1) {
  top: 8px;
  transform: rotate(135deg);
}

.hamburger.active span:nth-child(2) {
  opacity: 0;
  left: -24px;
}

.hamburger.active span:nth-child(3) {
  top: 8px;
  transform: rotate(-135deg);
}

.mobile-nav {
  display: none;
  background: rgba(0, 0, 0, 0.95);
  padding: 1rem;
  border-top: 1px solid var(--spa-gold);
}

.mobile-nav-open {
  display: block;
}

.mobile-nav-link {
  display: block;
  color: var(--spa-cream);
  text-decoration: none;
  padding: 1rem;
  font-weight: 600;
  border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  transition: all 0.3s ease;
}

.mobile-nav-link:hover,
.mobile-nav-link-active {
  color: var(--spa-gold);
  background: rgba(212, 175, 55, 0.1);
}

/* Page Headers */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
}

.page-header-content {
  flex: 1;
}

.page-title {
  font-size: 3.5rem;
  font-weight: 700;
  color: var(--spa-gold);
  margin-bottom: 1rem;
  text-shadow: 0 0 20px rgba(212, 175, 55, 0.3);
}

.page-subtitle {
  font-size: 1.2rem;
  color: var(--spa-cream);
  line-height: 1.6;
  max-width: 600px;
}

.page-decoration {
  flex: 0 0 300px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.decoration-image,
.decoration-logo {
  max-width: 250px;
  height: auto;
  filter: drop-shadow(0 0 15px rgba(212, 175, 55, 0.3));
  animation: gentle-float 4s ease-in-out infinite;
}

@keyframes gentle-float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-10px) rotate(2deg); }
}

/* Contact Page Logo Animation */
.contact-logo-animation {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.contact-animated-logo {
  max-width: 300px;
  height: auto;
  filter: drop-shadow(0 5px 15px rgba(0, 0, 0, 0.8));
  animation: gentle-sway 6s ease-in-out infinite;
  position: relative;
  z-index: 2;
}

/* Gentle sway animation for the logo */
@keyframes gentle-sway {
  0%, 100% { 
    transform: translateY(0px) translateX(0px) rotate(0deg);
  }
  25% { 
    transform: translateY(-10px) translateX(5px) rotate(2deg);
  }
  50% { 
    transform: translateY(-15px) translateX(0px) rotate(0deg);
  }
  75% { 
    transform: translateY(-10px) translateX(-5px) rotate(-2deg);
  }
}

/* Pim Thai Style with Agency FB Font */
.pim-style-homepage {
  background: transparent; /* Changed from white - allow fixed video to show */
  color: #333;
  font-family: 'Agency FB', 'Arial Narrow', sans-serif;
  padding-top: 100px; /* Space for header only */
  position: relative;
}

/* Global Font Setting */
* {
  font-family: 'Agency FB', 'Arial Narrow', sans-serif;
}

/* Performance optimizations */
html {
  scroll-behavior: smooth;
  font-family: 'Agency FB', 'Arial Narrow', sans-serif;
}

body {
  padding-top: 80px; /* Space for fixed navigation */
  padding-bottom: 0; /* No space at bottom - footer touches bottom */
  font-family: 'Agency FB', 'Arial Narrow', sans-serif;
  overflow-x: hidden;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}


/* ============================================
   FIXED VIDEO BACKGROUND - Stays in place
   ============================================ */

.fixed-video-background {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1; /* Behind all content */
  overflow: hidden;
}

.global-fixed-video {
  position: absolute;
  top: 50%;
  left: 50%;
  min-width: 100%;
  min-height: 100%;
  width: auto;
  height: auto;
  transform: translate(-50%, -50%);
  object-fit: cover;
}

.global-video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5); /* Dark overlay for content readability */
  z-index: 1;
}


/* Make all sections relative so they appear above fixed video */
.pim-hero,
.pim-hero-secondary,
.pim-welcome,
.pim-quote,
.pim-philosophy,
.pim-gift,
.pim-testimonial {
  position: relative;
  z-index: 1; /* Above fixed video background */
}



* {
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

/* Full-Size Buddha Hero - FIXED */
.pim-hero {
  position: fixed;
  top: 100px; /* Exactly below header golden line */
  left: 0;
  right: 0;
  width: 100vw;
  height: 110vh; /* Extra tall to show full image */
  overflow: hidden;
  z-index: 1;
  margin: 0;
  padding: 0;
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Secondary Hero - Herbal Compress */
.pim-hero-secondary {
  position: fixed;
  top: 100px;
  left: 0;
  right: 0;
  width: 100vw;
  height: 110vh;
  overflow: hidden;
  z-index: 0; /* Behind Buddha hero */
  margin: 0;
  padding: 0;
  opacity: 0;
  transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 1s ease;
}

.pim-hero-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.pim-hero-image img,
.pim-hero-image video {
  width: 100vw;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.pim-hero-video {
  position: absolute;
  top: 0;
  left: 0;
  min-width: 100%;
  min-height: 100%;
}

.pim-hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4);
  z-index: 2;
}

.pim-hero-content {
  position: absolute;
  top: 50%;
  right: 5%;
  transform: translateY(-50%);
  text-align: right;
  z-index: 10;
  width: 45%;
  max-width: 600px;
}

/* Hero Animated Logo */
.hero-logo-animated {
  max-width: 350px;
  width: 100%;
  height: auto;
  filter: drop-shadow(0 0 30px rgba(212, 175, 55, 0.6));
  transition: all 0.8s ease;
  margin-bottom: 2rem;
  animation: logoGlow3D 10s ease-in-out infinite alternate;
}

@keyframes logoGlow3D {
  0% { 
    filter: drop-shadow(0 0 20px rgba(212, 175, 55, 0.4));
  }
  100% { 
    filter: drop-shadow(0 0 40px rgba(212, 175, 55, 0.8));
  }
}

/* Lotus Transform Effect for Logo */
.hero-logo-animated.lotus-transform {
  animation: lotusDissolve 1s ease-out forwards;
}

@keyframes heroGlow3D {
  0% { 
    text-shadow: 
      3px 3px 0px rgba(0, 0, 0, 0.9),
      6px 6px 0px rgba(0, 0, 0, 0.7),
      9px 9px 0px rgba(0, 0, 0, 0.5),
      12px 12px 0px rgba(0, 0, 0, 0.3),
      15px 15px 20px rgba(0, 0, 0, 0.5),
      0 0 20px rgba(212, 175, 55, 0.3);
  }
  100% { 
    text-shadow: 
      3px 3px 0px rgba(0, 0, 0, 0.9),
      6px 6px 0px rgba(0, 0, 0, 0.7),
      9px 9px 0px rgba(0, 0, 0, 0.5),
      12px 12px 0px rgba(0, 0, 0, 0.3),
      15px 15px 20px rgba(0, 0, 0, 0.5),
      0 0 40px rgba(212, 175, 55, 0.6);
  }
}

/* Lotus Transform Effect */
.pim-hero-title.lotus-transform {
  animation: lotusDissolve 1s ease-out forwards;
}

@keyframes lotusDissolve {
  0% {
    letter-spacing: 2px;
  }
  50% {
    letter-spacing: 20px;
    text-shadow: 
      0 0 10px rgba(212, 175, 55, 0.8),
      0 0 20px rgba(212, 175, 55, 0.6),
      0 0 30px rgba(212, 175, 55, 0.4),
      5px 5px 0px rgba(255, 192, 203, 0.5),
      -5px -5px 0px rgba(255, 192, 203, 0.5);
  }
  100% {
    letter-spacing: 40px;
    opacity: 0;
    transform: scale(2) rotate(15deg);
    text-shadow: 
      0 0 20px rgba(212, 175, 55, 0.4),
      0 0 40px rgba(255, 192, 203, 0.6),
      10px 10px 0px rgba(255, 192, 203, 0.3),
      -10px -10px 0px rgba(255, 192, 203, 0.3);
  }
}

.pim-hero-button {
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-bronze) 100%);
  color: var(--spa-dark);
  padding: 1.2rem 3rem;
  font-size: 1.2rem;
  font-weight: 700;
  border: none;
  text-decoration: none;
  display: inline-block;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 1px;
  border-radius: 50px;
  box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
  backdrop-filter: blur(10px);
}

.pim-hero-button:hover {
  background: linear-gradient(135deg, var(--spa-gold-light) 0%, var(--spa-gold) 100%);
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(212, 175, 55, 0.5);
}

/* Remove old tagline styles - now using fixed slogan */

/* Parallax Container for all sections after Buddha */
.parallax-sections {
  position: relative;
  z-index: 20;
  margin-top: calc(100vh - 100px); /* Start below fixed hero */
}

.parallax-sections > section {
  position: relative;
  background-attachment: fixed;
  background-size: cover;
  background-position: center;
}

/* Welcome Section - With Parallax - CSS at line ~760 */

/* Footer pattern section removed - back to original */

/* Universal section borders removed - back to original state */

.pim-welcome {
  padding: 4rem 2rem;
  background-image: url('https://customer-assets.emergentagent.com/job_buathaispa/artifacts/3b56d607_Pozadina%20cista%20siva.jpg');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  position: relative;
  z-index: 50;
  transform-style: preserve-3d;
  will-change: transform;
  box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.3);
  overflow: visible;
  border-top: 2px solid var(--spa-gold);
  border-bottom: 2px solid var(--spa-gold);
}

.pim-welcome::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: calc(50% - 600px - 11cm + 300px + 4cm);
  background-image: url('https://customer-assets.emergentagent.com/job_a9e89e7a-058d-490d-923c-38f5cc2b3a04/artifacts/vakejrbs_bambus%20levo.png');
  background-size: auto 100%;
  background-repeat: no-repeat;
  background-position: left center;
  opacity: 0.95;
  z-index: 1;
  pointer-events: none;
}

.pim-welcome::after {
  content: '';
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: calc(50% - 600px - 11cm + 300px + 4cm);
  background-image: url('https://customer-assets.emergentagent.com/job_a9e89e7a-058d-490d-923c-38f5cc2b3a04/artifacts/oi3nac1f_Bambus%20desno.png');
  background-size: auto 100%;
  background-repeat: no-repeat;
  background-position: right center;
  opacity: 0.95;
  z-index: 1;
  pointer-events: none;
}

.pim-welcome-container {
  position: relative;
  z-index: 2; /* Above background and overlay */
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}

.pim-welcome-subtitle {
  color: var(--spa-gold);
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 1rem;
  text-align: center;
}

/* Animations and orphaned CSS removed */

.pim-welcome-title {
  color: var(--spa-gold);
  font-size: 2.5rem;
  font-weight: 800;
  margin-bottom: 2rem;
  text-align: center;
  letter-spacing: 1px;
}

.pim-welcome-content {
  display: block;
  text-align: center;
}

.pim-welcome-text p {
  font-size: 1.122rem;
  line-height: 1.7;
  margin-bottom: 1.5rem;
  color: white;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
  margin-bottom: 1.5rem;
}

/* Quote Section - Normal */
.pim-quote {
  position: relative;
  z-index: 1; /* Lower z-index so Philosophy section covers it */
  text-align: center;
  padding: 3rem 2rem;
  background: rgba(212, 175, 55, 0.1);
  margin: 0; /* Remove margin for full height */
  min-height: 100vh; /* Full viewport height */
  display: flex;
  align-items: center; /* Vertically center content */
  justify-content: center; /* Horizontally center content */
}

.pim-quote-content {
  max-width: 600px;
  margin: 0 auto;
}

.pim-quote-text {
  font-size: 2rem;
  color: var(--spa-gold);
  font-style: normal;
  font-family: 'Agency FB', 'Arial Narrow', sans-serif;
  margin-bottom: 1rem;
  line-height: 1.3;
}

.pim-quote-author {
  font-size: 1.1rem;
  color: var(--spa-gold);
  margin-bottom: 2rem;
  font-weight: 600;
}

.pim-quote-button {
  background: var(--spa-gold);
  color: var(--spa-dark);
  padding: 1rem 2rem;
  font-size: 1.1rem;
  font-weight: 700;
  border: none;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.pim-quote-button:hover {
  background: var(--spa-gold-dark);
  transform: translateY(-2px);
}

/* Philosophy Section - Covers content below */
.pim-philosophy {
  position: relative;
  z-index: 10; /* Higher z-index to cover quote section below */
  text-align: center;
  padding: 3rem 2rem;
  background: var(--spa-dark);
  overflow: hidden;
  min-height: 600px;
  margin-top: -10rem;
}

.pim-philosophy::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--spa-gold);
  z-index: 3;
}

.pim-philosophy::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--spa-gold);
  z-index: 3;
}

.pim-philosophy-title {
  position: relative;
  z-index: 2;
  color: var(--spa-gold);
  font-size: 2rem;
  font-weight: 800;
  margin-bottom: 2rem;
  letter-spacing: 2px;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
}

.pim-philosophy h2 {
  color: var(--spa-gold);
  font-size: 2rem;
  font-weight: 800;
  margin-bottom: 2rem;
  letter-spacing: 2px;
}

.pim-philosophy-content {
  position: relative;
  z-index: 2;
  max-width: 900px;
  margin: 0 auto 3rem;
}

.pim-philosophy-text {
  color: var(--spa-cream);
  font-size: 1.122rem;
  line-height: 1.8;
  text-align: left;
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.9);
}

.pim-philosophy-text p {
  margin-bottom: 1.5rem;
  text-indent: 2rem;
}

.pim-philosophy-text p:first-child {
  text-indent: 0;
}

/* Philosophy Video Background */
.pim-philosophy-video-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  z-index: 0;
}

.pim-philosophy-video {
  position: absolute;
  top: 50%;
  left: 50%;
  min-width: 100%;
  min-height: 100%;
  width: auto;
  height: auto;
  transform: translate(-50%, -50%);
  object-fit: cover;
  opacity: 0.6; /* Increased by 20% (was 0.4) */
}

.pim-philosophy-video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    135deg, 
    rgba(10, 10, 10, 0.7) 0%, 
    rgba(26, 26, 26, 0.6) 100%
  );
  z-index: 1;
}

/* Services Section */
.pim-services {
  padding: 4rem 2rem;
  max-width: 1400px;
  margin: 0 auto;
}

.pim-services-title {
  text-align: center;
  font-size: 2.5rem;
  color: var(--spa-dark);
  font-weight: 800;
  margin-bottom: 3rem;
  letter-spacing: 1px;
}

.pim-services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 2rem;
}

.pim-treatment-card {
  background: white;
  border: 1px solid #e0e0e0;
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  transition: all 0.3s ease;
  border-radius: 8px;
  overflow: hidden;
}

.pim-treatment-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 30px rgba(0,0,0,0.15);
}

.pim-treatment-image {
  width: 100%;
  height: 250px;
  overflow: hidden;
}

.pim-treatment-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.pim-treatment-card:hover .pim-treatment-image img {
  transform: scale(1.05);
}

.pim-treatment-content {
  padding: 1.5rem;
}

.pim-treatment-name {
  color: var(--spa-dark);
  font-size: 1.3rem;
  font-weight: 700;
  margin-bottom: 1rem;
}

.pim-treatment-description {
  color: #666;
  line-height: 1.6;
  margin-bottom: 1rem;
  font-size: 0.95rem;
}

.pim-treatment-duration {
  color: var(--spa-gold);
  font-weight: 600;
  margin-bottom: 1.5rem;
  font-size: 1rem;
}

.pim-treatment-button {
  background: var(--spa-gold);
  color: var(--spa-dark);
  border: none;
  font-weight: 600;
  transition: all 0.3s ease;
  width: 100%;
  padding: 0.8rem 1.5rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.pim-treatment-button:hover {
  background: var(--spa-gold-dark);
  transform: translateY(-2px);
}

/* Gift Section */
.pim-gift {
  text-align: center;
  padding: 4rem 2rem;
  background: #232222; /* Dark gray background for entire section */
  position: relative;
}

.pim-gift::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--spa-gold);
}

.pim-gift::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--spa-gold);
}

.pim-gift-title {
  font-size: 1.3rem;
  color: var(--spa-gold); /* Changed to gold for visibility on dark background */
  margin-bottom: 2rem;
  line-height: 1.6;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
  margin-bottom: 2rem;
}

/* Gift Voucher Showcase - 50% Size with Breathing Effect */
.pim-gift-voucher-showcase {
  margin: 2rem auto;
  max-width: 350px; /* 50% size (half of 700px) */
  perspective: 1000px;
  padding: 0;
  background: transparent;
  display: flex;
  justify-content: center;
  align-items: center;
}

.pim-gift-voucher-breathing {
  width: 100%;
  height: auto;
  filter: drop-shadow(0 10px 40px rgba(212, 175, 55, 0.5));
  animation: breathing 4s ease-in-out infinite;
  transition: filter 0.3s ease;
}

.pim-gift-voucher-breathing:hover {
  filter: drop-shadow(0 15px 60px rgba(212, 175, 55, 0.7));
}

@keyframes breathing {
  0%, 100% {
    transform: scale(1);
    opacity: 0.95;
  }
  50% {
    transform: scale(1.03);
    opacity: 1;
  }
}

.pim-gift-voucher-image {
  width: 100%;
  height: auto;
  background: transparent; /* No background on image */
  filter: drop-shadow(0 10px 40px rgba(212, 175, 55, 0.5));
  transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  transform-style: preserve-3d;
  animation: gentle-float 4s ease-in-out infinite;
  transform: scale(1);
}

.pim-gift-voucher-image:hover {
  transform: scale(1.05) rotateY(5deg) rotateX(2deg);
  filter: drop-shadow(0 15px 60px rgba(212, 175, 55, 0.7));
  box-shadow: 
    0 0 40px rgba(212, 175, 55, 0.4),
    0 0 80px rgba(212, 175, 55, 0.2);
}

@keyframes gentle-float {
  0%, 100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-10px);
  }
}

.pim-gift-button-bottom {
  background: var(--spa-gold);
  color: var(--spa-dark);
  padding: 1.5rem 4rem;
  font-size: 1.3rem;
  font-weight: 700;
  letter-spacing: 2px;
  border: none;
  transition: all 0.3s ease;
  text-transform: uppercase;
  margin-top: 2rem; /* Space above button */
  margin-bottom: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 5px 20px rgba(212, 175, 55, 0.3);
}

.pim-gift-button-bottom:hover {
  background: var(--spa-gold-dark);
  transform: translateY(-3px);
  box-shadow: 0 10px 35px rgba(212, 175, 55, 0.5);
}

/* Testimonial */
.pim-testimonial {
  display: none; /* Hide empty testimonial section */
  padding: 4rem 2rem; 
  min-height: 200px;
  background: transparent;
}

.about-testimonial,
.massage-testimonial,
.spa-testimonial {
  display: block; /* Show for spacing */
  padding: 4rem 2rem; 
  min-height: 200px;
  background: transparent;
}

.pim-testimonial-quote {
  font-size: 1.2rem;
  color: var(--spa-cream);
  line-height: 1.6;
  font-style: italic;
  margin-bottom: 1.5rem;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
  margin-bottom: 1.5rem;
}

.pim-testimonial-author {
  font-size: 1.1rem;
  color: var(--spa-gold);
  font-weight: 600;
  font-style: normal;
}

/* Hero Banner */
.hero-banner {
  background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.4)), 
              url('https://customer-assets.emergentagent.com/job_83ed575e-3634-46be-8586-79a3348def97/artifacts/i03j5uou_podloga.jpg');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  position: relative;
}

.hero-banner-content {
  max-width: 800px;
  padding: 2rem;
}

.hero-main-title {
  font-size: 4rem;
  font-weight: 900;
  color: var(--spa-gold);
  margin-bottom: 0.5rem;
  text-shadow: 0 0 30px rgba(212, 175, 55, 0.5);
  letter-spacing: 2px;
}

.hero-main-subtitle {
  font-size: 4rem;
  font-weight: 900;
  color: var(--spa-gold);
  margin-bottom: 1rem;
  text-shadow: 0 0 30px rgba(212, 175, 55, 0.5);
  letter-spacing: 2px;
}

.hero-tagline {
  font-size: 1.4rem;
  color: var(--spa-cream);
  margin-bottom: 2rem;
  font-weight: 300;
  opacity: 0.9;
}

.hero-cta-button {
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-bronze) 100%);
  color: var(--spa-dark);
  padding: 1.2rem 3rem;
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: 1px;
  border: none;
  transition: all 0.3s ease;
  text-transform: uppercase;
}

.hero-cta-button:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
}

/* Welcome Section */
.welcome-section {
  padding: 4rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
  z-index: 10;
}

.welcome-content {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 4rem;
  align-items: center;
}

.welcome-subtitle {
  color: var(--spa-gold);
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  letter-spacing: 0.5px;
}

.welcome-title {
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--spa-gold);
  margin-bottom: 1.5rem;
  letter-spacing: 1px;
}

.welcome-description {
  font-size: 1.1rem;
  line-height: 1.7;
  color: var(--spa-cream);
  margin-bottom: 1.5rem;
  opacity: 0.9;
}

.welcome-location {
  font-size: 1rem;
  color: var(--spa-gold-light);
  font-weight: 500;
}

.welcome-logo {
  width: 100%;
  max-width: 300px;
  height: auto;
  filter: drop-shadow(0 5px 15px rgba(0, 0, 0, 0.8));
}

/* Quote Section */
.quote-section {
  background: rgba(212, 175, 55, 0.05);
  padding: 3rem 2rem;
  text-align: center;
  border: 1px solid rgba(212, 175, 55, 0.2);
  margin: 2rem;
  border-radius: 15px;
  backdrop-filter: blur(15px);
}

.quote-content {
  max-width: 600px;
  margin: 0 auto;
}

.quote-icon {
  width: 40px;
  height: 40px;
  color: var(--spa-gold);
  margin-bottom: 1rem;
}

.quote-text {
  font-size: 1.8rem;
  color: var(--spa-cream);
  margin-bottom: 1rem;
  line-height: 1.4;
  font-style: italic;
}

.quote-author {
  font-size: 1.1rem;
  color: var(--spa-gold);
  margin-bottom: 2rem;
  font-weight: 600;
}

.quote-cta-button {
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-bronze) 100%);
  color: var(--spa-dark);
  padding: 1rem 2rem;
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: 1px;
  border: none;
  transition: all 0.3s ease;
}

.quote-cta-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
}

/* Treatments Section */
.treatments-section {
  padding: 4rem 2rem;
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
  z-index: 10;
}

.treatments-header {
  text-align: center;
  margin-bottom: 3rem;
}

.treatments-title {
  font-size: 3rem;
  color: var(--spa-gold);
  font-weight: 800;
  letter-spacing: 1px;
}

.treatments-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 2rem;
}

.treatment-card {
  background: rgba(212, 175, 55, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.2);
  backdrop-filter: blur(15px);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  border-radius: 15px;
}

.treatment-card:hover {
  transform: translateY(-5px);
  border-color: var(--spa-gold);
  box-shadow: 0 15px 40px rgba(212, 175, 55, 0.2);
}

.treatment-image-container {
  height: 250px;
  overflow: hidden;
  position: relative;
}

.treatment-image-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(45deg, rgba(212, 175, 55, 0.1), rgba(212, 175, 55, 0.05));
  display: flex;
  align-items: center;
  justify-content: center;
}

.treatment-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.treatment-card:hover .treatment-image {
  transform: scale(1.05);
}

.treatment-content {
  padding: 1.5rem;
}

.treatment-name {
  color: var(--spa-gold);
  font-size: 1.4rem;
  font-weight: 700;
  margin-bottom: 1rem;
}

.treatment-description {
  color: var(--spa-cream);
  line-height: 1.6;
  margin-bottom: 1rem;
  opacity: 0.9;
  font-size: 0.95rem;
}

.treatment-duration {
  color: var(--spa-gold-light);
  font-weight: 600;
  margin-bottom: 1.5rem;
  font-size: 1rem;
}

.book-treatment-button {
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-bronze) 100%);
  color: var(--spa-dark);
  border: none;
  font-weight: 600;
  transition: all 0.3s ease;
  width: 100%;
  padding: 0.8rem 1.5rem;
}

.book-treatment-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
}

/* Gift Section */
.gift-section {
  padding: 4rem 2rem;
  text-align: center;
  background: rgba(212, 175, 55, 0.05);
  margin: 2rem;
  border-radius: 15px;
  border: 1px solid rgba(212, 175, 55, 0.2);
  backdrop-filter: blur(15px);
}

.gift-content {
  max-width: 800px;
  margin: 0 auto;
}

.gift-title {
  font-size: 1.3rem;
  color: var(--spa-cream);
  margin-bottom: 2rem;
  line-height: 1.6;
  opacity: 0.9;
}

.gift-voucher {
  margin: 2rem 0;
}

.gift-voucher-image {
  max-width: 400px;
  width: 100%;
  height: auto;
  border-radius: 10px;
  filter: drop-shadow(0 0 20px rgba(212, 175, 55, 0.3));
}

.gift-cta-button {
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-bronze) 100%);
  color: var(--spa-dark);
  padding: 1.2rem 3rem;
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: 1px;
  border: none;
  transition: all 0.3s ease;
  text-transform: uppercase;
}

.gift-cta-button:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
}

/* Testimonial Section */
.testimonial-section {
  padding: 4rem 2rem;
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
}

.testimonial-content {
  background: rgba(212, 175, 55, 0.05);
  padding: 3rem;
  border-radius: 15px;
  border: 1px solid rgba(212, 175, 55, 0.2);
  backdrop-filter: blur(15px);
}

.testimonial-quote-icon {
  width: 50px;
  height: 50px;
  color: var(--spa-gold);
  margin-bottom: 1.5rem;
}

.testimonial-text {
  font-size: 1.2rem;
  color: var(--spa-cream);
  margin-bottom: 1.5rem;
  line-height: 1.6;
  font-style: italic;
}

.testimonial-author {
  font-size: 1.1rem;
  color: var(--spa-gold);
  font-weight: 600;
  margin-bottom: 1rem;
}

.testimonial-stars {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
}

.star-filled {
  width: 20px;
  height: 20px;
  color: var(--spa-gold);
  fill: var(--spa-gold);
}

/* Legacy Styles (keeping for other pages) */
.home-container {
  color: var(--spa-cream);
  position: relative;
  z-index: 5;
  background: linear-gradient(135deg, var(--spa-dark) 0%, #1a1a1a 100%);
}

.hero-section {
  padding: 4rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
  z-index: 10;
}

.hero-content {
  display: flex;
  align-items: center;
  gap: 4rem;
}

.hero-text {
  flex: 1;
}

.hero-title {
  font-size: 4rem;
  font-weight: 800;
  color: var(--spa-gold);
  margin-bottom: 1rem;
  text-shadow: 0 0 30px rgba(212, 175, 55, 0.4);
  line-height: 1.1;
}

.hero-subtitle {
  font-size: 1.8rem;
  color: var(--spa-gold-light);
  margin-bottom: 1.5rem;
  font-weight: 300;
}

.hero-description {
  font-size: 1.2rem;
  line-height: 1.6;
  margin-bottom: 2rem;
  color: var(--spa-cream);
  opacity: 0.9;
}

.hero-buttons {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.hero-button-primary {
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-bronze) 100%);
  color: var(--spa-dark);
  border: none;
  padding: 1rem 2rem;
  font-size: 1.1rem;
  font-weight: 600;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
}

.hero-button-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
  background: linear-gradient(135deg, var(--spa-gold-light) 0%, var(--spa-gold) 100%);
}

.hero-button-secondary {
  color: var(--spa-gold);
  border: 2px solid var(--spa-gold);
  background: transparent;
  padding: 1rem 2rem;
  font-size: 1.1rem;
  font-weight: 600;
  transition: all 0.3s ease;
}

.hero-button-secondary:hover {
  background: var(--spa-gold);
  color: var(--spa-dark);
  transform: translateY(-2px);
}

.hero-mandala {
  flex: 0 0 400px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.mandala-image {
  width: 100%;
  max-width: 350px;
  height: auto;
  filter: drop-shadow(0 0 25px rgba(212, 175, 55, 0.4));
  animation: slow-rotate 60s linear infinite;
}

@keyframes slow-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Section Styles */
.section-separator {
  background: linear-gradient(90deg, transparent, var(--spa-gold), transparent);
  height: 1px;
  border: none;
  margin: 4rem 0;
  opacity: 0.6;
}

.services-preview {
  padding: 4rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}

.services-header {
  margin-bottom: 3rem;
}

.services-title {
  font-size: 2.5rem;
  color: var(--spa-gold);
  margin-bottom: 1rem;
  font-weight: 700;
}

.services-subtitle {
  font-size: 1.1rem;
  color: var(--spa-cream);
  opacity: 0.8;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  margin-bottom: 3rem;
}

.service-card {
  background: rgba(212, 175, 55, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.2);
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
  overflow: hidden;
}

.service-card:hover {
  transform: translateY(-10px);
  border-color: var(--spa-gold);
  box-shadow: 0 15px 40px rgba(212, 175, 55, 0.2);
}

.service-image-container {
  height: 200px;
  overflow: hidden;
  position: relative;
}

.service-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.service-card:hover .service-image {
  transform: scale(1.1);
}

.service-content {
  padding: 1.5rem;
}

.service-name {
  font-size: 1.3rem;
  color: var(--spa-gold);
  margin-bottom: 0.5rem;
  font-weight: 600;
}

.service-price {
  color: var(--spa-cream);
  font-size: 1.1rem;
  opacity: 0.8;
}

.services-cta {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

.services-button {
  padding: 1rem 2rem;
  font-size: 1.1rem;
  font-weight: 600;
  transition: all 0.3s ease;
}

.services-button:hover {
  transform: translateY(-2px);
}

/* Benefits of Massage Section */
.benefits-massage-section {
  padding: 4rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
  z-index: 10;
}

.benefits-container {
  text-align: center;
}

.benefits-header {
  margin-bottom: 3rem;
}

.benefits-main-title {
  font-size: 2.8rem;
  color: var(--spa-gold);
  margin-bottom: 0.5rem;
  font-weight: 700;
  text-shadow: 0 0 20px rgba(212, 175, 55, 0.3);
}

.benefits-subtitle {
  font-size: 1.8rem;
  color: var(--spa-gold-light);
  font-weight: 300;
  opacity: 0.8;
}

.benefits-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
  margin-bottom: 3rem;
}

.benefit-card {
  background: rgba(212, 175, 55, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 15px;
  padding: 2rem;
  text-align: center;
  backdrop-filter: blur(15px);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.benefit-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.1), transparent);
  transition: left 0.5s ease;
}

.benefit-card:hover::before {
  left: 100%;
}

.benefit-card:hover {
  transform: translateY(-10px);
  border-color: var(--spa-gold);
  box-shadow: 0 15px 40px rgba(212, 175, 55, 0.2);
}

.benefit-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
  filter: drop-shadow(0 0 10px rgba(212, 175, 55, 0.3));
}

.benefit-card h4 {
  color: var(--spa-gold);
  font-size: 1.3rem;
  font-weight: 700;
  margin-bottom: 1rem;
}

.benefit-card p {
  color: var(--spa-cream);
  line-height: 1.6;
  opacity: 0.9;
}

.benefits-description {
  max-width: 800px;
  margin: 0 auto;
  padding: 2rem;
  background: rgba(212, 175, 55, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 15px;
  backdrop-filter: blur(15px);
}

.benefits-text {
  font-size: 1.1rem;
  line-height: 1.7;
  color: var(--spa-cream);
  opacity: 0.9;
  margin: 0;
}

/* About Preview */
.about-preview {
  padding: 4rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
  z-index: 10;
}

.about-content {
  display: flex;
  align-items: center;
  gap: 4rem;
}

.about-text {
  flex: 1;
}

.about-title {
  font-size: 2.5rem;
  color: var(--spa-gold);
  margin-bottom: 1.5rem;
  font-weight: 700;
}

.about-description {
  font-size: 1.1rem;
  line-height: 1.6;
  color: var(--spa-cream);
  opacity: 0.9;
  margin-bottom: 2rem;
}

.about-button {
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-bronze) 100%);
  color: var(--spa-dark);
  border: none;
  padding: 1rem 2rem;
  font-size: 1.1rem;
  font-weight: 600;
  transition: all 0.3s ease;
}

.about-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
}

.about-pattern {
  flex: 0 0 300px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.pattern-image {
  width: 100%;
  max-width: 250px;
  height: auto;
  border-radius: 10px;
  filter: drop-shadow(0 0 20px rgba(212, 175, 55, 0.3));
}

/* Footer */
.footer-container {
  background: linear-gradient(135deg, var(--spa-dark) 0%, #1a1a1a 100%);
  color: var(--spa-cream);
  margin-top: 11rem;
  position: relative;
  overflow: hidden;
  border-top: 2px solid var(--spa-gold);
  z-index: 100;
}

.footer-content {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 3rem;
  padding: 0.1rem 2rem;
  padding-top: 4rem;
  padding-bottom: 4rem;
  max-width: 1200px;
  margin: 0 auto;
}

.footer-section {
  z-index: 2;
  position: relative;
}

.footer-title {
  color: var(--spa-gold);
  font-size: 1.3rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
}

.footer-contact {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.footer-contact-item {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  color: var(--spa-cream);
  transition: color 0.3s ease;
  font-size: 1.0506rem;
}

.footer-contact-item:hover {
  color: var(--spa-gold);
}

.footer-icon {
  width: 20px;
  height: 20px;
  color: var(--spa-gold);
}

.footer-social {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.footer-social-link {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  color: var(--spa-cream);
  text-decoration: none;
  transition: all 0.3s ease;
  padding: 0.5rem;
  border-radius: 5px;
  font-size: 1.0506rem;
}

.footer-social-link:hover {
  color: var(--spa-gold);
  background: rgba(212, 175, 55, 0.1);
  transform: translateX(5px);
}

.footer-social-icon {
  width: 24px;
  height: 24px;
}

.footer-bottom {
  text-align: center;
  padding: 1rem 2rem 1rem 2rem;
  margin-top: 0;
  margin-bottom: 0;
  position: relative;
  background: linear-gradient(135deg, var(--spa-dark) 0%, #1a1a1a 100%);
  min-height: 100px;
}

.footer-bottom::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--spa-gold);
}

.footer-bottom::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--spa-gold);
}

.footer-mandala-pattern {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100px;
  background-image: url('https://customer-assets.emergentagent.com/job_83ed575e-3634-46be-8586-79a3348def97/artifacts/lghkaqzq_%E2%80%94Pngtree%E2%80%94thai%20retro%20pattern%20exotic%20border_9031382.png');
  background-size: cover;
  background-position: center top;
  background-repeat: no-repeat;
  opacity: 0.1;
  filter: sepia(100%) hue-rotate(30deg);
}

.footer-copyright {
  color: var(--spa-cream);
  opacity: 0.7;
  font-size: 0.9rem;
  position: absolute;
  z-index: 2;
  top: 50%;
  left: 0;
  right: 0;
  transform: translateY(-50%);
  margin: 0;
  padding: 0;
  text-align: center;
}

/* Services Pages (Massage & Spa) */
.massage-container,
.spa-container,
.about-container,
/* Contact Page - EXTREME Compact Version (70% reduction) */
.contact-container .page-header {
  padding: 0.3rem;
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  align-items: center;
  max-width: 500px;
  margin: 0 auto;
}

.contact-container .page-decoration {
  order: -1;
  margin-bottom: 0.3rem;
}

.contact-container .page-title {
  font-size: 1.35rem; /* 70% of 2.25rem */
  margin-bottom: 0.3rem;
  text-align: center;
  order: 1;
  font-weight: 700;
  letter-spacing: 1.5px;
}

.contact-container .contact-animated-logo {
  max-width: 150px; /* Bigger logo */
  margin: 0;
}

.contact-container .page-header-content {
  order: 1;
  width: 100%;
  text-align: center;
}

/* Contact Section EXTREME Compact */
.contact-section {
  padding: 0.1rem;
  max-width: 700px;
  margin: 0 auto;
  position: relative;
}

.contact-grid {
  display: grid;
  grid-template-columns: 360px 1fr 120px; /* Fixed width for form, flexible middle, booking on right */
  gap: 0.05rem; /* Minimal gap */
  column-gap: 0.05rem; /* Very small horizontal gap - was 0.1rem */
}

/* Form Card - Column 1, Row 1 */
.contact-form-card {
  grid-column: 1;
  grid-row: 1;
}

/* Contact Info - Column 2, Row 1 (first row, right side) */
.contact-info {
  grid-column: 2;
  grid-row: 1;
}

/* Map Card - Third column (right), Row 1 */
.map-card {
  grid-column: 3;
  grid-row: 1;
  width: 110px;
}
/* Form Card - Column 1, Row 1 - ALL THE WAY LEFT */
.contact-form-card {
  grid-column: 1;
  grid-row: 1;
  justify-self: start;
  width: 100%;
  max-width: 360px; /* 100% wider - was 180px */
  margin-right: 0; /* No margin on right */
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.2) 0%, rgba(212, 175, 55, 0.05) 100%);
  border: 1.5px solid rgba(212, 175, 55, 0.5);
  padding: 0.15rem;
  box-shadow: 0 3px 10px rgba(212, 175, 55, 0.2);
  border-radius: 6px;
}

.contact-form-card .card-header {
  padding: 0.15rem;
  border-bottom: 1px solid rgba(212, 175, 55, 0.3);
}

.contact-form-card .card-content {
  padding: 0.15rem;
}

.contact-form-card .form-title {
  font-size: 0.8rem; /* Increased from 0.7rem */
  margin-bottom: 0.1rem;
  font-weight: 700;
  color: var(--spa-gold);
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
}

.contact-form-card .form-subtitle {
  font-size: 0.65rem; /* Increased from 0.55rem */
  margin-bottom: 0.1rem;
  color: var(--spa-cream);
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 0.075rem; /* 50% smaller - was 0.15rem */
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.075rem; /* 50% smaller - was 0.15rem */
}

.form-group {
  margin: 0;
}

.form-group label {
  font-size: 0.7rem; /* Increased from 0.6rem */
  margin-bottom: 0.05rem;
  font-weight: 600;
  color: var(--spa-gold);
}

.form-input,
.form-textarea {
  font-size: 0.75rem; /* Increased from 0.65rem */
  padding: 0.1rem;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(212, 175, 55, 0.3);
}

.form-textarea {
  min-height: 35px;
}

.submit-button {
  margin-top: 0.075rem;
  font-size: 0.75rem; /* Increased from 0.65rem */
  padding: 0.15rem 0.3rem;
  font-weight: 600;
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-bronze) 100%);
  border: none;
  box-shadow: 0 2px 8px rgba(212, 175, 55, 0.3);
}

/* Contact Info EXTREME Compact */
.contact-info {
  grid-column: 2;
  grid-row: 1;
  display: flex;
  flex-direction: column;
  gap: 0.05rem; /* 50% smaller - was 0.1rem */
}

/* Social Card - Separate positioning in Row 2, Column 1, Far Left */
.social-card {
  grid-column: 1 !important;
  grid-row: 2 !important;
  justify-self: start;
  width: 110px;
  background: rgba(0, 0, 0, 0.8);
  border: 1px solid rgba(212, 175, 55, 0.2);
  padding: 0.1rem;
}

.info-card,
.social-card,
.map-card {
  background: rgba(0, 0, 0, 0.8);
  border: 1px solid rgba(212, 175, 55, 0.2);
  padding: 0.1rem;
}

.info-card .card-header,
.social-card .card-header,
.map-card .card-header {
  padding: 0.1rem;
}

.info-card .card-content,
.social-card .card-content,
.map-card .card-content {
  padding: 0.1rem;
}

.info-title,
.social-title,
.map-title {
  font-size: 0.6rem; /* Increased from 0.5rem */
  margin-bottom: 0.075rem;
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 0.05rem; /* 50% smaller - was 0.1rem */
}

.info-item {
  display: flex;
  gap: 0.075rem;
  padding: 0.05rem 0;
}

.info-icon,
.social-icon {
  width: 10px;
  height: 10px;
  color: var(--spa-gold);
  flex-shrink: 0;
}

.info-details h4,
.social-info h4 {
  font-size: 0.6rem; /* Increased from 0.5rem */
  margin-bottom: 0.05rem;
  font-weight: 600;
}

.info-text,
.info-link,
.social-info p {
  font-size: 0.55rem; /* Increased from 0.45rem */
}

.working-hours {
  font-size: 0.55rem; /* Increased from 0.45rem */
}

.hours {
  font-weight: 600;
  color: var(--spa-gold);
}

.map-content {
  padding: 0.1rem;
}

.map-placeholder {
  padding: 0.15rem;
  gap: 0.075rem;
}

.map-icon {
  width: 10px;
  height: 10px;
}

.map-placeholder p {
  font-size: 0.55rem; /* Increased from 0.45rem */
}

.map-note {
  font-size: 0.5rem; /* Increased from 0.4rem */
}

.map-button {
  font-size: 0.55rem; /* Increased from 0.45rem */
  padding: 0.1rem 0.2rem;
  margin-top: 0.075rem;
}

/* Additional Info - Same row as Form (Row 1), Next to it */
.contact-container .additional-info {
  grid-column: 1;
  grid-row: 1;
  justify-self: end; /* Stick directly to the form's right edge */
  align-self: start;
  width: 110px;
  padding: 0;
  margin: 0;
  margin-top: 0;
  margin-right: 0; /* No gap - directly attached to form */
  max-width: none;
}

.booking-info-card {
  background: rgba(212, 175, 55, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.2);
}

.booking-info {
  padding: 0.15rem;
}

.booking-title {
  font-size: 0.65rem; /* Increased from 0.55rem */
  margin-bottom: 0.15rem;
}

.booking-details {
  display: flex;
  flex-direction: column;
  gap: 0.1rem; /* 50% smaller - was 0.2rem */
}

.booking-item h4 {
  font-size: 0.6rem; /* Increased from 0.5rem */
  margin-bottom: 0.05rem;
  font-weight: 600;
}

.booking-item p {
  font-size: 0.55rem; /* Increased from 0.45rem */
}

.social-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.contact-container {
  color: var(--spa-cream);
  min-height: 100vh;
}

.services-section {
  padding: 2rem;
  max-width: 1400px;
  margin: 0 auto;
}

.massage-card,
.spa-card {
  background: rgba(212, 175, 55, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.2);
  backdrop-filter: blur(15px);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.massage-card:hover,
.spa-card:hover {
  transform: translateY(-5px);
  border-color: var(--spa-gold);
  box-shadow: 0 15px 40px rgba(212, 175, 55, 0.2);
}

.popular-badge {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-bronze) 100%);
  color: var(--spa-dark);
  border: none;
  font-weight: 600;
  z-index: 10;
}

.massage-name,
.spa-name {
  color: var(--spa-gold);
  font-size: 1.4rem;
  font-weight: 700;
  margin-bottom: 1rem;
}

.massage-meta,
.spa-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid rgba(212, 175, 55, 0.2);
}

.duration {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--spa-cream);
  opacity: 0.8;
}

.price {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--spa-gold-light);
}

.massage-description,
.spa-description {
  color: var(--spa-cream);
  line-height: 1.6;
  margin-bottom: 1.5rem;
  opacity: 0.9;
}

.benefits {
  margin-bottom: 1.5rem;
}

.benefits-title {
  color: var(--spa-gold);
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.8rem;
}

.benefits-list {
  list-style: none;
  padding: 0;
}

.benefit-item {
  color: var(--spa-cream);
  padding: 0.3rem 0;
  position: relative;
  padding-left: 1.2rem;
  opacity: 0.8;
}

.benefit-item::before {
  content: '✦';
  position: absolute;
  left: 0;
  color: var(--spa-gold);
  font-size: 0.8rem;
}

.book-button {
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-bronze) 100%);
  color: var(--spa-dark);
  border: none;
  font-weight: 600;
  transition: all 0.3s ease;
}

.book-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
}

/* Spa Specific Styles */
.spa-category {
  margin-bottom: 1rem;
}

.category-badge {
  color: white;
  font-weight: 600;
  border: none;
}

/* Call to Action Section */
.cta-section {
  padding: 4rem 2rem;
  text-align: center;
  background: radial-gradient(circle at center, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
  margin-top: 3rem;
  border-top: 2px solid var(--spa-gold);
  border-bottom: 2px solid var(--spa-gold);
}

.cta-content {
  max-width: 800px;
  margin: 0 auto;
}

.cta-title {
  font-size: 2.5rem;
  color: var(--spa-gold);
  margin-bottom: 1rem;
  font-weight: 700;
}

.cta-subtitle {
  font-size: 1.2rem;
  color: var(--spa-cream);
  margin-bottom: 2rem;
  opacity: 0.9;
}

.cta-buttons {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

.cta-button-primary {
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-bronze) 100%);
  color: var(--spa-dark);
  border: none;
  padding: 1rem 2rem;
  font-size: 1.1rem;
  font-weight: 600;
  transition: all 0.3s ease;
}

.cta-button-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
}

.cta-button-secondary {
  color: var(--spa-gold);
  border: 2px solid var(--spa-gold);
  background: transparent;
  padding: 1rem 2rem;
  font-size: 1.1rem;
  font-weight: 600;
  transition: all 0.3s ease;
}

.cta-button-secondary:hover {
  background: var(--spa-gold);
  color: var(--spa-dark);
  transform: translateY(-2px);
}

/* Spa Packages */
.packages-section {
  padding: 3rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}

.packages-header {
  margin-bottom: 3rem;
}

.packages-title {
  font-size: 2.2rem;
  color: var(--spa-gold);
  margin-bottom: 1rem;
  font-weight: 700;
}

.packages-subtitle {
  font-size: 1.1rem;
  color: var(--spa-cream);
  opacity: 0.8;
}

.packages-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 2rem;
}

.package-card {
  background: rgba(212, 175, 55, 0.08);
  border: 2px solid rgba(212, 175, 55, 0.3);
  backdrop-filter: blur(15px);
  transition: all 0.3s ease;
}

.package-card:hover {
  transform: translateY(-5px);
  border-color: var(--spa-gold);
  box-shadow: 0 15px 40px rgba(212, 175, 55, 0.2);
}

.package-name {
  color: var(--spa-gold);
  font-size: 1.3rem;
  font-weight: 700;
}

.package-price {
  font-size: 1.4rem;
  color: var(--spa-gold-light);
  font-weight: 700;
}

.package-description {
  color: var(--spa-cream);
  opacity: 0.9;
  margin-bottom: 1rem;
}

.package-duration {
  color: var(--spa-gold);
  font-weight: 600;
  font-size: 1.1rem;
}

/* About Page Specific Styles */
.story-section {
  padding: 3rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
}

.story-content {
  display: flex;
  align-items: center;
  gap: 4rem;
}

.story-text {
  flex: 1;
}

.story-title {
  font-size: 2.5rem;
  color: var(--spa-gold);
  margin-bottom: 2rem;
  font-weight: 700;
}

.story-paragraphs p {
  font-size: 1.1rem;
  line-height: 1.7;
  color: var(--spa-cream);
  margin-bottom: 1.5rem;
  opacity: 0.9;
}

.story-image {
  flex: 0 0 300px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.story-pattern {
  width: 100%;
  max-width: 250px;
  height: auto;
  border-radius: 10px;
  filter: drop-shadow(0 0 20px rgba(212, 175, 55, 0.3));
}

/* Values Section */
.values-section {
  padding: 3rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}

.values-title {
  font-size: 2.5rem;
  color: var(--spa-gold);
  margin-bottom: 3rem;
  font-weight: 700;
}

.values-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
}

.value-card {
  background: rgba(212, 175, 55, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.2);
  backdrop-filter: blur(15px);
  transition: all 0.3s ease;
  text-align: center;
}

.value-card:hover {
  transform: translateY(-5px);
  border-color: var(--spa-gold);
  box-shadow: 0 15px 40px rgba(212, 175, 55, 0.2);
}

.value-content {
  padding: 2rem;
}

.value-icon {
  color: var(--spa-gold);
  margin-bottom: 1rem;
}

.value-name {
  color: var(--spa-gold);
  font-size: 1.4rem;
  font-weight: 700;
  margin-bottom: 1rem;
}

.value-description {
  color: var(--spa-cream);
  line-height: 1.6;
  opacity: 0.9;
}

/* Team Section */
.team-section {
  padding: 3rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}

.team-title {
  font-size: 2.5rem;
  color: var(--spa-gold);
  margin-bottom: 1rem;
  font-weight: 700;
}

.team-subtitle {
  font-size: 1.1rem;
  color: var(--spa-cream);
  opacity: 0.8;
  margin-bottom: 3rem;
}

.team-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 2rem;
}

.team-card {
  background: rgba(212, 175, 55, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.2);
  backdrop-filter: blur(15px);
  transition: all 0.3s ease;
  text-align: left;
}

.team-card:hover {
  transform: translateY(-5px);
  border-color: var(--spa-gold);
  box-shadow: 0 15px 40px rgba(212, 175, 55, 0.2);
}

.team-content {
  padding: 2rem;
}

.member-name {
  color: var(--spa-gold);
  font-size: 1.4rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
}

.member-position {
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-bronze) 100%);
  color: var(--spa-dark);
  margin-bottom: 1.5rem;
}

.member-details {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.member-experience {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--spa-gold-light);
  font-weight: 600;
}

.member-specialty,
.member-certification {
  color: var(--spa-cream);
  opacity: 0.9;
  line-height: 1.5;
}

/* Certifications */
.certifications-section {
  padding: 3rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
}

.certifications-title {
  font-size: 2.2rem;
  color: var(--spa-gold);
  margin-bottom: 2rem;
  font-weight: 700;
  text-align: center;
}

.certifications-grid {
  display: grid;
  gap: 1.5rem;
}

.certification-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.5rem;
  background: rgba(212, 175, 55, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 10px;
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
}

.certification-item:hover {
  border-color: var(--spa-gold);
  transform: translateX(10px);
}

.certification-icon {
  color: var(--spa-gold);
  width: 32px;
  height: 32px;
  flex-shrink: 0;
}

.certification-text h4 {
  color: var(--spa-gold);
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.certification-text p {
  color: var(--spa-cream);
  opacity: 0.8;
}

/* Contact Page Styles */
.contact-section {
  padding: 2rem;
  max-width: 1400px;
  margin: 0 auto;
}


/* ============================================
   UNIFIED CONTACT CARD STYLES
   ============================================ */

.unified-contact-card {
  background: rgba(212, 175, 55, 0.05);
  border: 2px solid rgba(212, 175, 55, 0.3);
  backdrop-filter: blur(15px);
  border-radius: 15px;
  overflow: hidden;
}

.unified-contact-content {
  padding: 3rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
}

/* Form Section - Spans 2 columns, first row */
.unified-form-section {
  grid-column: 1 / -1;
  padding-bottom: 2rem;
  border-bottom: 1px solid rgba(212, 175, 55, 0.2);
}

.unified-section-title {
  color: var(--spa-gold);
  font-size: 1.8rem;
  font-weight: 700;
  margin-bottom: 1rem;
}

.unified-section-subtitle {
  color: var(--spa-cream);
  opacity: 0.8;
  margin-bottom: 1.5rem;
}

.unified-contact-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  max-width: 800px;
}

/* Booking Information Section */
.unified-booking-section {
  padding-top: 2rem;
}

.unified-booking-details {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  margin-top: 1rem;
}

.unified-booking-item h4 {
  color: var(--spa-gold);
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.unified-booking-item p {
  color: var(--spa-cream);
  opacity: 0.9;
  font-size: 0.95rem;
  line-height: 1.5;
}

/* Contact Information Section */
.unified-info-section {
  padding-top: 2rem;
}

.unified-info-items {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  margin-top: 1rem;
}

.unified-info-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.unified-info-icon {
  color: var(--spa-gold);
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  margin-top: 0.2rem;
}

.unified-info-details h4 {
  color: var(--spa-gold);
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.unified-info-details p,
.unified-info-details a {
  color: var(--spa-cream);
  font-size: 0.95rem;
  line-height: 1.5;
}

.unified-info-details a {
  transition: color 0.3s ease;
}

.unified-info-details a:hover {
  color: var(--spa-gold-light);
}

/* Social Media Section */
.unified-social-section {
  grid-column: 1 / -1;
  padding-top: 2rem;
  border-top: 1px solid rgba(212, 175, 55, 0.2);
  margin-top: 2rem;
}

.unified-social-link {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  background: rgba(212, 175, 55, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 10px;
  transition: all 0.3s ease;
  text-decoration: none;
  max-width: 400px;
  margin-top: 1rem;
}

.unified-social-link:hover {
  background: rgba(212, 175, 55, 0.1);
  border-color: var(--spa-gold);
  transform: translateY(-2px);
  box-shadow: 0 5px 20px rgba(212, 175, 55, 0.2);
}

.unified-social-icon {
  color: var(--spa-gold);
  width: 32px;
  height: 32px;
  flex-shrink: 0;
}

.unified-social-info h4 {
  color: var(--spa-gold);
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.unified-social-info p {
  color: var(--spa-cream);
  opacity: 0.9;
  font-size: 0.95rem;
}

/* Responsive Design for Unified Card */
/* @media (max-width: 1024px) {
  .unified-contact-content {
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2rem;
  } */
  
  .unified-form-section {
    grid-column: 1;
  }
  
  .unified-social-section {
    grid-column: 1;
  }
}

/* @media (max-width: 768px) {
  .unified-contact-content {
    padding: 1.5rem;
    gap: 1.5rem;
  } */
  
  .unified-section-title {
    font-size: 1.5rem;
  }
}


.contact-grid {
  display: grid;
  grid-template-columns: 1fr 400px;
  column-gap: 0.5rem; /* Gap between column 1 and 2 */
  row-gap: 3rem;
}

.contact-form-card {
  background: rgba(212, 175, 55, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.2);
  backdrop-filter: blur(15px);
}

.form-title {
  color: var(--spa-gold);
  font-size: 1.8rem;
  font-weight: 700;
}

.form-subtitle {
  color: var(--spa-cream);
  opacity: 0.8;
  margin-top: 0.5rem;
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-input,
.form-textarea {
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(212, 175, 55, 0.3);
  color: var(--spa-cream);
  padding: 0.8rem 1rem;
  border-radius: 6px;
  transition: all 0.3s ease;
}

.form-input:focus,
.form-textarea:focus {
  border-color: var(--spa-gold);
  box-shadow: 0 0 15px rgba(212, 175, 55, 0.2);
  outline: none;
}

.form-input::placeholder,
.form-textarea::placeholder {
  color: rgba(245, 242, 232, 0.5);
}

.submit-button {
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-bronze) 100%);
  color: var(--spa-dark);
  border: none;
  padding: 1rem 2rem;
  font-size: 1.1rem;
  font-weight: 600;
  transition: all 0.3s ease;
}

.submit-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
}

.submit-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Contact Info */
.contact-info {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.info-card,
.social-card,
.map-card {
  background: rgba(212, 175, 55, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.2);
  backdrop-filter: blur(15px);
}

.info-title,
.social-title,
.map-title {
  color: var(--spa-gold);
  font-size: 1.3rem;
  font-weight: 700;
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.info-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.info-icon {
  color: var(--spa-gold);
  width: 20px;
  height: 20px;
  margin-top: 0.2rem;
  flex-shrink: 0;
}

.info-details h4 {
  color: var(--spa-gold);
  font-weight: 600;
  margin-bottom: 0.3rem;
}

.info-link {
  color: var(--spa-cream);
  text-decoration: none;
  transition: color 0.3s ease;
}

.info-link:hover {
  color: var(--spa-gold);
}

.info-text {
  color: var(--spa-cream);
  opacity: 0.9;
  line-height: 1.4;
}

.working-hours {
  color: var(--spa-cream);
  opacity: 0.9;
}

.hours {
  color: var(--spa-gold-light);
  font-weight: 600;
}

.social-link {
  display: flex;
  align-items: center;
  gap: 1rem;
  color: var(--spa-cream);
  text-decoration: none;
  padding: 1rem;
  border-radius: 8px;
  transition: all 0.3s ease;
}

.social-link:hover {
  color: var(--spa-gold);
  background: rgba(212, 175, 55, 0.1);
}

.social-icon {
  width: 24px;
  height: 24px;
  color: var(--spa-gold);
}

.social-info h4 {
  color: var(--spa-gold);
  font-weight: 600;
  margin-bottom: 0.2rem;
}

.social-info p {
  opacity: 0.8;
}

/* Map */
.map-content {
  text-align: center;
}

.map-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 2rem;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 8px;
  color: var(--spa-cream);
}

.map-icon {
  width: 48px;
  height: 48px;
  color: var(--spa-gold);
}

.map-note {
  opacity: 0.7;
  font-size: 0.9rem;
}

.map-button {
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-bronze) 100%);
  border: none;
  color: var(--spa-dark);
  font-weight: 600;
  transition: all 0.3s ease;
}

.map-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(212, 175, 55, 0.3);
}

/* Additional Info */
.additional-info {
  padding: 2rem;
  max-width: 1200px;
  margin: 2rem auto 0;
}

.booking-info-card {
  background: rgba(212, 175, 55, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.2);
  backdrop-filter: blur(15px);
}

.booking-info {
  padding: 2rem;
}

.booking-title {
  color: var(--spa-gold);
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
  text-align: center;
}

.booking-details {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
}

.booking-item h4 {
  color: var(--spa-gold);
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.booking-item p {
  color: var(--spa-cream);
  opacity: 0.9;
  line-height: 1.5;
}

/* Smooth Scrolling and Performance */
html {
  scroll-behavior: smooth;
}

.parallax-container {
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.parallax-bg {
  transform: translate3d(0, 0, 0);
  -webkit-transform: translate3d(0, 0, 0);
}

/* Enhanced Animations */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.benefit-card {
  animation: fadeInUp 0.6s ease-out forwards;
}

.benefit-card:nth-child(1) { animation-delay: 0.1s; }
.benefit-card:nth-child(2) { animation-delay: 0.2s; }
.benefit-card:nth-child(3) { animation-delay: 0.3s; }
.benefit-card:nth-child(4) { animation-delay: 0.4s; }
.benefit-card:nth-child(5) { animation-delay: 0.5s; }

/* Improved Section Separators */
.section-separator {
  background: linear-gradient(90deg, transparent, var(--spa-gold), transparent);
  height: 2px;
  border: none;
  margin: 4rem 0;
  opacity: 0.4;
  position: relative;
  z-index: 10;
}

.section-separator::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60px;
  height: 60px;
  background: radial-gradient(circle, var(--spa-gold) 0%, transparent 70%);
  border-radius: 50%;
  opacity: 0.3;
}

/* Enhanced Content Sections */
.services-preview,
.benefits-massage-section,
.about-preview {
  backdrop-filter: blur(2px);
  background: rgba(0, 0, 0, 0.1);
  border-radius: 20px;
  margin: 2rem;
  padding: 4rem 2rem;
  border: 1px solid rgba(212, 175, 55, 0.1);
}

/* Responsive Design */
/* @media (max-width: 768px) {
  .parallax-bg {
    background-attachment: scroll;
  } */
  
  .logo-section {
    padding: 1rem 0;
    min-height: 100px;
  }
  
  .logo-image {
    max-height: 140px;
    transform: scale(1.05);
  }
  
  /* Pim Style Mobile Responsive */
  .pim-hero {
    height: 70vh; /* Smaller height on mobile */
  }

  .pim-hero-image {
    height: 70vh; /* Match hero height on mobile */
    position: absolute; /* Switch to absolute on mobile */
  }

  .pim-hero-title {
    font-size: 2.5rem;
    line-height: 1.1;
    padding: 0 1rem;
  }

  .pim-hero-button {
    padding: 1rem 2rem;
    font-size: 1rem;
  }

  .pim-welcome {
    background-attachment: scroll; /* Disable fixed background on mobile */
    min-height: auto;
    padding: 3rem 1rem;
  }

  .pim-welcome-title {
    font-size: 2rem;
  }

  /* Disable parallax on mobile for better performance */
  .pim-parallax-layer {
    transform: none !important;
  }

  .pim-tagline h2 {
    font-size: 1.5rem;
  }

  .pim-welcome-content {
    grid-template-columns: 1fr;
    gap: 2rem;
    text-align: center;
  }

  .pim-welcome-title {
    font-size: 2rem;
  }

  .pim-quote-text {
    font-size: 1.4rem;
  }

  .pim-services-title {
    font-size: 2rem;
  }

  .pim-services-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .pim-treatment-card {
    margin: 0 auto;
    max-width: 400px;
  }

  .pim-gift-title {
    font-size: 1.1rem;
  }

  .pim-gift-button,
  .pim-gift-button-bottom {
    padding: 1rem 2rem;
    font-size: 1rem;
  }

  .pim-testimonial-quote {
    font-size: 1rem;
  }
  
  /* Legacy Mobile Styles */
  .hero-main-title,
  .hero-main-subtitle {
    font-size: 2.5rem;
  }
  
  .hero-tagline {
    font-size: 1.1rem;
  }
  
  .welcome-content {
    grid-template-columns: 1fr;
    gap: 2rem;
    text-align: center;
  }
  
  .welcome-title {
    font-size: 2rem;
  }
  
  .treatments-title {
    font-size: 2.2rem;
  }
  
  .treatments-grid {
    grid-template-columns: 1fr;
  }
  
  .treatment-card {
    margin: 0 auto;
    max-width: 400px;
  }
  
  .quote-text {
    font-size: 1.4rem;
  }
  
  .gift-title {
    font-size: 1.1rem;
  }
  
  .testimonial-text {
    font-size: 1rem;
  }
  
  .gift-section,
  .quote-section {
    margin: 1rem;
    padding: 2rem 1rem;
  }
  
  /* Legacy Mobile Styles */
  .benefits-main-title {
    font-size: 2.2rem;
  }
  
  .benefits-subtitle {
    font-size: 1.4rem;
  }
  
  .benefits-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .benefit-card {
    padding: 1.5rem;
  }
  
  .services-preview,
  .benefits-massage-section,
  .about-preview {
    margin: 1rem;
    padding: 2rem 1rem;
  }
  
  .nav-desktop {
    display: none;
  }
  
  .mobile-menu-button {
    display: block;
  }
  
  .hero-content,
  .about-content,
  .page-header,
  .story-content {
    flex-direction: column;
    text-align: center;
    gap: 2rem;
  }
  
  .hero-title {
    font-size: 2.5rem;
  }
  
  .page-title {
    font-size: 2.5rem;
  }
  
  .hero-mandala,
  .about-pattern,
  .page-decoration,
  .story-image {
    flex: none;
  }
  
  .services-grid,
  .values-grid,
  .team-grid,
  .packages-grid {
    grid-template-columns: 1fr;
  }
  
  .contact-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  .form-row {
    grid-template-columns: 1fr;
  }
  
  .booking-details {
    grid-template-columns: 1fr;
  }
  
  .cta-buttons,
  .hero-buttons {
    flex-direction: column;
    align-items: center;
  }


/* ============================================
   GALLERY SECTION STYLES
   ============================================ */

.gallery-section {
  padding: 4rem 2rem;
  max-width: 1400px;
  margin: 0 auto;
}

.gallery-header {
  text-align: center;
  margin-bottom: 3rem;
}

.gallery-title {
  font-size: 2.5rem;
  font-weight: 700;
  color: var(--spa-gold);
  margin-bottom: 1rem;
  text-shadow: 0 0 20px rgba(212, 175, 55, 0.3);
}

.gallery-subtitle {
  font-size: 1.2rem;
  color: var(--spa-cream);
  opacity: 0.8;
}

/* Main Carousel */
.gallery-carousel {
  position: relative;
  margin-bottom: 2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
}

.carousel-image-container {
  width: 100%;
  max-width: 900px;
  height: 500px;
  border-radius: 15px;
  overflow: hidden;
  border: 2px solid rgba(212, 175, 55, 0.3);
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  transition: all 0.3s ease;
}

.carousel-image-container:hover {
  border-color: var(--spa-gold);
  box-shadow: 0 15px 50px rgba(212, 175, 55, 0.3);
  transform: scale(1.02);
}

.carousel-main-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.carousel-main-image:hover {
  transform: scale(1.05);
}

.carousel-btn {
  background: rgba(212, 175, 55, 0.2);
  border: 2px solid var(--spa-gold);
  color: var(--spa-gold);
  padding: 1rem;
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
}

.carousel-btn:hover {
  background: var(--spa-gold);
  color: var(--spa-dark);
  transform: scale(1.1);
  box-shadow: 0 0 20px rgba(212, 175, 55, 0.5);
}

.carousel-btn:active {
  transform: scale(0.95);
}

/* Thumbnail Grid */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
  margin-top: 2rem;
}

.gallery-item {
  position: relative;
  width: 100%;
  height: 180px;
  border-radius: 10px;
  overflow: hidden;
  cursor: pointer;
  border: 2px solid rgba(212, 175, 55, 0.2);
  transition: all 0.3s ease;
}

.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.gallery-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(10, 10, 10, 0.3);
  transition: all 0.3s ease;
}

.gallery-item:hover {
  border-color: var(--spa-gold);
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(212, 175, 55, 0.3);
}

.gallery-item:hover img {
  transform: scale(1.15);
}

.gallery-item:hover .gallery-overlay {
  background: rgba(212, 175, 55, 0.2);
}

.gallery-item.active {
  border-color: var(--spa-gold);
  box-shadow: 0 0 30px rgba(212, 175, 55, 0.5);
}

.gallery-item.active .gallery-overlay {
  background: rgba(212, 175, 55, 0.3);
}

/* ============================================
   ENHANCED CARD HOVER EFFECTS
   ============================================ */

.massage-card,
.spa-card {
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.massage-card::before,
.spa-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(184, 148, 31, 0.1) 100%);
  opacity: 0;
  transition: opacity 0.4s ease;
  pointer-events: none;
}

.massage-card:hover,
.spa-card:hover {
  transform: translateY(-10px) scale(1.02);
  border-color: var(--spa-gold);
  box-shadow: 0 20px 60px rgba(212, 175, 55, 0.4);
}

.massage-card:hover::before,
.spa-card:hover::before {
  opacity: 1;
}

.massage-card:hover .massage-name,
.spa-card:hover .spa-name {
  color: var(--spa-gold-light);
  text-shadow: 0 0 15px rgba(212, 175, 55, 0.5);
}

.massage-card:hover .book-button,
.spa-card:hover .book-button {
  transform: scale(1.05);
  background: linear-gradient(135deg, var(--spa-gold) 0%, var(--spa-gold-light) 100%);
  box-shadow: 0 5px 20px rgba(212, 175, 55, 0.5);
}

.book-button {
  transition: all 0.3s ease;
}

/* Package Cards Hover */
.package-card {
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  position: relative;
  overflow: hidden;
}

.package-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(184, 148, 31, 0.1) 100%);
  opacity: 0;
  transition: opacity 0.4s ease;
  pointer-events: none;
}

.package-card:hover {
  transform: translateY(-10px) scale(1.03);
  border-color: var(--spa-gold);
  box-shadow: 0 20px 60px rgba(212, 175, 55, 0.4);
}

.package-card:hover::before {
  opacity: 1;
}

.package-card:hover .package-name {
  color: var(--spa-gold-light);
  text-shadow: 0 0 15px rgba(212, 175, 55, 0.5);
}

/* Responsive Gallery */
/* @media (max-width: 768px) {
  .gallery-carousel {
    flex-direction: column;
  } */
  
  .carousel-image-container {
    height: 350px;
  }
  
  .carousel-btn {
    padding: 0.75rem;
  }
  
  .gallery-grid {
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.75rem;
  }
  
  .gallery-item {
    height: 140px;
  }
  
  .gallery-title {
    font-size: 2rem;
  }
  
  .gallery-subtitle {
    font-size: 1rem;
  }
}

}


/* ============================================
   PROFESSIONAL ABOUT PAGE
   ============================================ */

.about-professional-container {
  background: linear-gradient(180deg, #000000 0%, #0a0a0a 100%);
  min-height: 100vh;
}

/* Hero Section */
.about-pro-hero {
  position: relative;
  height: 85vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(10, 10, 10, 0.95) 0%, rgba(26, 26, 26, 0.9) 100%),
              url('https://images.unsplash.com/photo-1544161515-4ab6ce6db874?w=1920&q=80');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
}

.about-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.4) 0%,
    rgba(0, 0, 0, 0.7) 100%
  );
  z-index: 1;
}

.about-hero-content-wrapper {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 2rem;
  max-width: 900px;
}

.about-hero-title {
  font-size: clamp(4rem, 10vw, 7rem);
  font-weight: 900;
  color: var(--spa-gold);
  margin-bottom: 2rem;
  letter-spacing: 0.05em;
  animation: heroTitleFade 1.5s ease-out;
  text-shadow: 
    0 0 40px rgba(212, 175, 55, 0.5),
    0 10px 30px rgba(0, 0, 0, 0.8);
}

@keyframes heroTitleFade {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.about-hero-divider {
  width: 100px;
  height: 3px;
  background: linear-gradient(90deg, transparent, var(--spa-gold), transparent);
  margin: 0 auto 2rem;
  animation: dividerGrow 1.5s ease-out 0.5s backwards;
}

@keyframes dividerGrow {
  from {
    width: 0;
    opacity: 0;
  }
  to {
    width: 100px;
    opacity: 1;
  }
}

.about-hero-subtitle {
  font-size: clamp(1.2rem, 2.5vw, 1.6rem);
  color: var(--spa-cream);
  opacity: 0.95;
  line-height: 1.7;
  max-width: 700px;
  margin: 0 auto;
  animation: heroSubtitleFade 1.5s ease-out 0.7s backwards;
}

@keyframes heroSubtitleFade {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 0.95;
    transform: translateY(0);
  }
}

.scroll-indicator {
  position: absolute;
  bottom: 3rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
}

.scroll-dot {
  width: 30px;
  height: 50px;
  border: 2px solid rgba(212, 175, 55, 0.5);
  border-radius: 25px;
  position: relative;
  animation: scrollBounce 2s ease-in-out infinite;
}

.scroll-dot::before {
  content: '';
  position: absolute;
  top: 8px;
  left: 50%;
  transform: translateX(-50%);
  width: 6px;
  height: 6px;
  background: var(--spa-gold);
  border-radius: 50%;
  animation: scrollDot 2s ease-in-out infinite;
}

@keyframes scrollBounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(10px);
  }
}

@keyframes scrollDot {
  0% {
    opacity: 0;
    transform: translateX(-50%) translateY(0);
  }
  50%, 100% {
    opacity: 1;
    transform: translateX(-50%) translateY(20px);
  }
}

/* Container */
.container-pro {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
}

/* Story Section */
.about-pro-story {
  padding: 8rem 0;
  background: #000000;
}

.story-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6rem;
  align-items: center;
}

.story-image-side {
  position: relative;
}

.story-image-frame {
  position: relative;
  aspect-ratio: 4/5;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
}

.story-image-frame::before {
  content: '';
  position: absolute;
  inset: -2px;
  background: linear-gradient(135deg, var(--spa-gold), transparent, var(--spa-gold));
  border-radius: 20px;
  z-index: -1;
  opacity: 0.5;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(26, 26, 26, 0.9) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  width: 100px;
  height: 100px;
  color: var(--spa-gold);
  opacity: 0.3;
}

.story-content-side {
  animation: fadeInUp 1s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section-label {
  display: inline-block;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--spa-gold);
  text-transform: uppercase;
  letter-spacing: 0.2em;
  margin-bottom: 1rem;
}

.section-title {
  font-size: clamp(2.5rem, 5vw, 4rem);
  color: var(--spa-gold);
  margin-bottom: 2rem;
  line-height: 1.2;
}

.story-text p {
  font-size: 1.15rem;
  line-height: 1.8;
  color: var(--spa-cream);
  opacity: 0.9;
  margin-bottom: 1.5rem;
}

.story-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin-top: 3rem;
  padding-top: 3rem;
  border-top: 1px solid rgba(212, 175, 55, 0.2);
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: 3rem;
  font-weight: 900;
  color: var(--spa-gold);
  margin-bottom: 0.5rem;
}

.stat-label {
  font-size: 0.95rem;
  color: var(--spa-cream);
  opacity: 0.8;
}

/* Values Section */
.about-pro-values {
  padding: 8rem 0;
  background: linear-gradient(180deg, #000000 0%, #0a0a0a 50%, #000000 100%);
}

.section-header-center {
  text-align: center;
  max-width: 800px;
  margin: 0 auto 5rem;
}

.section-description {
  font-size: 1.15rem;
  line-height: 1.7;
  color: var(--spa-cream);
  opacity: 0.85;
  margin-top: 1rem;
}

.values-grid-pro {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rem;
  margin-top: 4rem;
}

.value-card-pro {
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.05) 0%, rgba(26, 26, 26, 0.8) 100%);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 20px;
  padding: 3rem 2rem;
  text-align: center;
  transition: all 0.4s ease;
  position: relative;
  overflow: hidden;
}

.value-card-pro::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), transparent);
  opacity: 0;
  transition: opacity 0.4s ease;
}

.value-card-pro:hover {
  transform: translateY(-10px);
  border-color: rgba(212, 175, 55, 0.5);
  box-shadow: 0 20px 60px rgba(212, 175, 55, 0.2);
}

.value-card-pro:hover::before {
  opacity: 1;
}

.value-icon-wrapper {
  width: 80px;
  height: 80px;
  margin: 0 auto 2rem;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.2), rgba(212, 175, 55, 0.05));
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.4s ease;
}

.value-card-pro:hover .value-icon-wrapper {
  transform: scale(1.1) rotate(5deg);
}

.value-icon {
  width: 40px;
  height: 40px;
  color: var(--spa-gold);
}

.value-title {
  font-size: 1.8rem;
  color: var(--spa-gold);
  margin-bottom: 1rem;
}

.value-description {
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--spa-cream);
  opacity: 0.85;
}

/* Team Section */
.about-pro-team {
  padding: 8rem 0;
  background: #000000;
}

.team-grid-pro {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rem;
}

.team-member-card {
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.05) 0%, rgba(15, 15, 15, 0.9) 100%);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 20px;
  overflow: hidden;
  transition: all 0.4s ease;
}

.team-member-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 20px 60px rgba(212, 175, 55, 0.2);
  border-color: rgba(212, 175, 55, 0.5);
}

.member-image-wrapper {
  aspect-ratio: 1;
  overflow: hidden;
  position: relative;
}

.member-image-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.15) 0%, rgba(26, 26, 26, 0.9) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-placeholder-icon {
  width: 80px;
  height: 80px;
  color: var(--spa-gold);
  opacity: 0.4;
}

.member-info {
  padding: 2rem;
  text-align: center;
}

.member-name {
  font-size: 1.5rem;
  color: var(--spa-gold);
  margin-bottom: 0.5rem;
}

.member-role {
  font-size: 1.1rem;
  color: var(--spa-cream);
  opacity: 0.9;
  margin-bottom: 1rem;
}

.member-experience {
  font-size: 1rem;
  color: var(--spa-cream);
  opacity: 0.7;
  margin-bottom: 0.5rem;
}

.member-certification {
  font-size: 0.95rem;
  color: var(--spa-cream);
  opacity: 0.6;
  font-style: italic;
}

/* Philosophy Section */
.about-pro-philosophy {
  padding: 8rem 0;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.05) 0%, #000000 50%, rgba(212, 175, 55, 0.05) 100%);
  position: relative;
  overflow: hidden;
}

.philosophy-content {
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
  position: relative;
  z-index: 2;
}

.philosophy-icon-large {
  width: 100px;
  height: 100px;
  margin: 0 auto 2rem;
  color: var(--spa-gold);
  opacity: 0.3;
}

.philosophy-icon-large svg {
  width: 100%;
  height: 100%;
}

.philosophy-title {
  font-size: clamp(2.5rem, 5vw, 4rem);
  color: var(--spa-gold);
  margin-bottom: 2rem;
}

.philosophy-text {
  font-size: 1.3rem;
  line-height: 1.9;
  color: var(--spa-cream);
  opacity: 0.95;
  font-style: italic;
  margin-bottom: 3rem;
}

.philosophy-signature {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
}

.signature-line {
  width: 60px;
  height: 1px;
  background: var(--spa-gold);
  opacity: 0.5;
}

.signature-text {
  font-size: 1.1rem;
  color: var(--spa-gold);
  letter-spacing: 0.1em;
}

/* CTA Section */
.about-pro-cta {
  padding: 8rem 0;
  background: #000000;
}

.cta-content-pro {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
  padding: 5rem 3rem;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.08) 0%, rgba(15, 15, 15, 0.9) 100%);
  border: 2px solid rgba(212, 175, 55, 0.3);
  border-radius: 30px;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
}

.cta-title-pro {
  font-size: clamp(2.5rem, 5vw, 3.5rem);
  color: var(--spa-gold);
  margin-bottom: 1.5rem;
}

.cta-subtitle-pro {
  font-size: 1.3rem;
  color: var(--spa-cream);
  opacity: 0.9;
  margin-bottom: 3rem;
  line-height: 1.6;
}

.cta-buttons-pro {
  display: flex;
  gap: 2rem;
  justify-content: center;
  flex-wrap: wrap;
}

.cta-button-primary-pro,
.cta-button-secondary-pro {
  padding: 1.2rem 3rem;
  font-size: 1.1rem;
  font-weight: 700;
  border-radius: 50px;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.cta-button-primary-pro {
  background: linear-gradient(135deg, var(--spa-gold) 0%, #FFA500 100%);
  color: var(--spa-dark);
  border: none;
}

.cta-button-primary-pro:hover {
  transform: translateY(-3px);
  box-shadow: 0 15px 40px rgba(212, 175, 55, 0.4);
}

.cta-button-secondary-pro {
  background: transparent;
  color: var(--spa-gold);
  border: 2px solid var(--spa-gold);
}

.cta-button-secondary-pro:hover {
  transform: translateY(-3px);
  background: rgba(212, 175, 55, 0.1);
  box-shadow: 0 15px 40px rgba(212, 175, 55, 0.2);
}

/* Responsive */
/* @media (max-width: 1024px) {
  .story-grid {
    grid-template-columns: 1fr;
    gap: 4rem;
  } */

  .story-image-frame {
    max-width: 500px;
    margin: 0 auto;
  }

  .values-grid-pro,
  .team-grid-pro {
    grid-template-columns: 1fr;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .story-stats {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
}

/* @media (max-width: 768px) {
  .about-pro-hero {
    height: 70vh;
  } */

  .about-hero-title {
    font-size: 3rem;
  }

  .about-pro-story,
  .about-pro-values,
  .about-pro-team,
  .about-pro-philosophy,
  .about-pro-cta {
    padding: 4rem 0;
  }

  .section-title {
    font-size: 2rem;
  }

  .cta-content-pro {
    padding: 3rem 2rem;
  }

  .cta-buttons-pro {
    flex-direction: column;
    gap: 1rem;
  }

  .cta-button-primary-pro,
  .cta-button-secondary-pro {
    width: 100%;
  }
}



/* ============================================
   3D ABOUT PAGE STYLES
   ============================================ */

.about-container-3d {
  min-height: 100vh;
  background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0a0a0a 100%);
  overflow-x: hidden;
  position: relative;
}

/* 3D Hero Section */
.about-hero-3d {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.about-hero-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-gradient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.3;
  animation: float 8s ease-in-out infinite;
}

.hero-orb-1 {
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, var(--spa-gold) 0%, transparent 70%);
  top: 10%;
  left: 10%;
  animation-delay: 0s;
}

.hero-orb-2 {
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, #FFD700 0%, transparent 70%);
  top: 50%;
  right: 10%;
  animation-delay: 2s;
}

.hero-orb-3 {
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, var(--spa-gold) 0%, transparent 70%);
  bottom: 10%;
  left: 30%;
  animation-delay: 4s;
}

@keyframes float {
  0%, 100% {
    transform: translate(0, 0) scale(1);
  }
  33% {
    transform: translate(30px, -30px) scale(1.1);
  }
  66% {
    transform: translate(-20px, 20px) scale(0.9);
  }
}

.about-hero-content {
  position: relative;
  z-index: 10;
  text-align: center;
  padding: 2rem;
}

.about-hero-title-3d {
  font-size: 6rem;
  font-weight: 900;
  background: linear-gradient(135deg, var(--spa-gold) 0%, #FFD700 50%, var(--spa-gold) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: 
    0 0 40px rgba(212, 175, 55, 0.5),
    0 0 80px rgba(212, 175, 55, 0.3);
  margin-bottom: 1rem;
  transform-style: preserve-3d;
  animation: titlePulse 3s ease-in-out infinite;
}

@keyframes titlePulse {
  0%, 100% {
    text-shadow: 
      0 0 40px rgba(212, 175, 55, 0.5),
      0 0 80px rgba(212, 175, 55, 0.3);
  }
  50% {
    text-shadow: 
      0 0 60px rgba(212, 175, 55, 0.7),
      0 0 120px rgba(212, 175, 55, 0.5);
  }
}

.about-hero-subtitle-3d {
  font-size: 1.5rem;
  color: var(--spa-cream);
  opacity: 0.9;
  max-width: 600px;
  margin: 0 auto;
}

.hero-sparkles {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
}

.sparkle {
  position: absolute;
  color: var(--spa-gold);
  opacity: 0;
  animation: sparkleAnimation 3s ease-in-out infinite;
}

.sparkle-1 {
  top: 20%;
  left: 20%;
  animation-delay: 0s;
}

.sparkle-2 {
  top: 30%;
  right: 25%;
  animation-delay: 1s;
}

.sparkle-3 {
  bottom: 25%;
  left: 30%;
  animation-delay: 2s;
}

@keyframes sparkleAnimation {
  0%, 100% {
    opacity: 0;
    transform: scale(0) rotate(0deg);
  }
  50% {
    opacity: 1;
    transform: scale(1.5) rotate(180deg);
  }
}

/* 3D Story Section */
.story-section-3d {
  padding: 8rem 2rem;
  position: relative;
}

.story-container-3d {
  max-width: 1200px;
  margin: 0 auto;
  perspective: 2000px;
}

.story-card-3d {
  position: relative;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(26, 26, 26, 0.8) 100%);
  border: 1px solid rgba(212, 175, 55, 0.3);
  border-radius: 30px;
  padding: 4rem;
  transform-style: preserve-3d;
  transition: transform 0.3s ease;
  backdrop-filter: blur(10px);
  box-shadow: 
    0 20px 60px rgba(0, 0, 0, 0.5),
    inset 0 1px 0 rgba(212, 175, 55, 0.1);
}

.story-card-glow {
  position: absolute;
  top: -2px;
  left: -2px;
  right: -2px;
  bottom: -2px;
  background: linear-gradient(135deg, var(--spa-gold), #FFD700, var(--spa-gold));
  border-radius: 30px;
  opacity: 0;
  z-index: -1;
  transition: opacity 0.3s ease;
  filter: blur(20px);
}

.story-card-3d:hover .story-card-glow {
  opacity: 0.3;
}

.story-title-3d {
  font-size: 3rem;
  color: var(--spa-gold);
  margin-bottom: 2rem;
  text-align: center;
  transform: translateZ(50px);
  text-shadow: 0 10px 30px rgba(212, 175, 55, 0.3);
}

.story-content-3d p {
  font-size: 1.2rem;
  line-height: 1.8;
  color: var(--spa-cream);
  margin-bottom: 1.5rem;
  transform: translateZ(20px);
  opacity: 0.9;
}

.lotus-decoration {
  position: absolute;
  bottom: 2rem;
  right: 2rem;
  opacity: 0.2;
}

.lotus-leaf {
  width: 100px;
  height: 100px;
  color: var(--spa-gold);
  animation: leafRotate 6s linear infinite;
}

@keyframes leafRotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* 3D Values Section */
.values-section-3d {
  padding: 8rem 2rem;
  background: linear-gradient(180deg, transparent 0%, rgba(10, 10, 10, 0.5) 50%, transparent 100%);
}

.values-title-3d {
  font-size: 3.5rem;
  color: var(--spa-gold);
  text-align: center;
  margin-bottom: 4rem;
  transform-style: preserve-3d;
}

.values-grid-3d {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 3rem;
  max-width: 1200px;
  margin: 0 auto;
  perspective: 1000px;
}

.value-card-3d {
  position: relative;
  width: 100%;
  height: 400px;
  transform-style: preserve-3d;
  cursor: pointer;
  animation: cardFloat 3s ease-in-out infinite;
}

.value-card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  text-align: center;
  transition: transform 0.6s;
  transform-style: preserve-3d;
}

.value-card-3d:hover .value-card-inner {
  transform: rotateY(180deg);
}

.value-card-front,
.value-card-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

.value-card-front {
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.15) 0%, rgba(26, 26, 26, 0.9) 100%);
  border: 1px solid rgba(212, 175, 55, 0.3);
}

.value-card-back {
  background: linear-gradient(135deg, rgba(26, 26, 26, 0.9) 0%, rgba(212, 175, 55, 0.15) 100%);
  border: 1px solid rgba(212, 175, 55, 0.5);
  transform: rotateY(180deg);
}

.value-icon-3d {
  margin-bottom: 1.5rem;
  animation: iconBounce 2s ease-in-out infinite;
}

@keyframes iconBounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}

.value-title {
  font-size: 2rem;
  color: var(--spa-gold);
  margin-bottom: 1rem;
}

.value-description-3d {
  font-size: 1.1rem;
  line-height: 1.6;
  color: var(--spa-cream);
  opacity: 0.9;
}

@keyframes cardFloat {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-20px);
  }
}

/* 3D Team Section */
.team-section-3d {
  padding: 8rem 2rem;
  position: relative;
}

.team-title-3d {
  font-size: 3.5rem;
  color: var(--spa-gold);
  text-align: center;
  margin-bottom: 4rem;
  text-shadow: 0 10px 40px rgba(212, 175, 55, 0.3);
}

.team-grid-3d {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 3rem;
  max-width: 1200px;
  margin: 0 auto;
}

.team-member-3d {
  perspective: 1000px;
}

.member-card-3d {
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(26, 26, 26, 0.8) 100%);
  border: 1px solid rgba(212, 175, 55, 0.3);
  border-radius: 20px;
  padding: 3rem 2rem;
  text-align: center;
  transform-style: preserve-3d;
  transition: transform 0.5s ease, box-shadow 0.5s ease;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

.member-card-3d:hover {
  transform: translateY(-20px) rotateX(5deg);
  box-shadow: 0 30px 80px rgba(212, 175, 55, 0.3);
}

.member-avatar {
  position: relative;
  width: 120px;
  height: 120px;
  margin: 0 auto 2rem;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--spa-gold) 0%, #FFD700 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: avatarPulse 2s ease-in-out infinite;
}

.avatar-glow {
  position: absolute;
  inset: -10px;
  border-radius: 50%;
  background: var(--spa-gold);
  filter: blur(20px);
  opacity: 0.5;
  z-index: -1;
}

.member-star {
  width: 60px;
  height: 60px;
  color: var(--spa-dark);
  animation: starRotate 4s linear infinite;
}

@keyframes avatarPulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

@keyframes starRotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.member-name-3d {
  font-size: 1.8rem;
  color: var(--spa-gold);
  margin-bottom: 0.5rem;
}

.member-role-3d {
  font-size: 1.2rem;
  color: var(--spa-cream);
  opacity: 0.8;
  margin-bottom: 1.5rem;
}

.member-details-3d {
  font-size: 1rem;
  color: var(--spa-cream);
  opacity: 0.7;
  line-height: 1.8;
}

.member-details-3d p {
  margin-bottom: 0.5rem;
}

/* 3D CTA Section */
.cta-section-3d {
  padding: 8rem 2rem;
  position: relative;
  overflow: hidden;
}

.cta-container-3d {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
  position: relative;
  z-index: 10;
}

.cta-zap {
  position: absolute;
  color: var(--spa-gold);
  opacity: 0.3;
  animation: zapAnimation 2s ease-in-out infinite;
}

.cta-zap-1 {
  width: 60px;
  height: 60px;
  top: 10%;
  left: 10%;
  animation-delay: 0s;
}

.cta-zap-2 {
  width: 80px;
  height: 80px;
  bottom: 10%;
  right: 10%;
  animation-delay: 1s;
}

@keyframes zapAnimation {
  0%, 100% {
    transform: scale(1) rotate(0deg);
    opacity: 0.3;
  }
  50% {
    transform: scale(1.2) rotate(180deg);
    opacity: 0.6;
  }
}

.cta-title-3d {
  font-size: 3rem;
  color: var(--spa-gold);
  margin-bottom: 1rem;
  text-shadow: 0 10px 40px rgba(212, 175, 55, 0.3);
  animation: titleGlow 2s ease-in-out infinite;
}

@keyframes titleGlow {
  0%, 100% {
    text-shadow: 0 10px 40px rgba(212, 175, 55, 0.3);
  }
  50% {
    text-shadow: 0 10px 60px rgba(212, 175, 55, 0.6);
  }
}

.cta-subtitle-3d {
  font-size: 1.3rem;
  color: var(--spa-cream);
  opacity: 0.9;
  margin-bottom: 3rem;
}

.cta-buttons-3d {
  display: flex;
  gap: 2rem;
  justify-content: center;
  flex-wrap: wrap;
}

.cta-button-3d {
  padding: 1.5rem 3rem;
  font-size: 1.2rem;
  font-weight: 700;
  border-radius: 50px;
  transition: all 0.3s ease;
  transform-style: preserve-3d;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.cta-button-primary {
  background: linear-gradient(135deg, var(--spa-gold) 0%, #FFD700 100%);
  color: var(--spa-dark);
  border: none;
}

.cta-button-primary:hover {
  transform: translateY(-5px) scale(1.05);
  box-shadow: 0 20px 50px rgba(212, 175, 55, 0.5);
}

.cta-button-secondary {
  background: transparent;
  color: var(--spa-gold);
  border: 2px solid var(--spa-gold);
}

.cta-button-secondary:hover {
  transform: translateY(-5px) scale(1.05);
  background: rgba(212, 175, 55, 0.1);
  box-shadow: 0 20px 50px rgba(212, 175, 55, 0.3);
}

/* Responsive Design */
/* @media (max-width: 768px) {
  .about-hero-title-3d {
    font-size: 3rem;
  } */

  .about-hero-subtitle-3d {
    font-size: 1.1rem;
  }
}



/* ============================================
   MASSAGE PAGE - FIXED VIDEO HERO & PARALLAX
   ============================================ */

/* Fixed Video Hero Section */
.massage-hero-fixed {
  position: fixed;
  top: 80px;
  left: 0;
  width: 100%;
  height: calc(100vh - 80px);
  z-index: 0;
  overflow: hidden;
  will-change: transform;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.massage-hero-video-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.video-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
}

.massage-hero-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.massage-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.4) 0%,
    rgba(0, 0, 0, 0.7) 100%
  );
  z-index: 1;
}

.massage-hero-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 2rem;
  margin-top: 0;
}

.massage-hero-logo {
  margin-bottom: 1.5rem;
  margin-top: 3.5cm;
  animation: gentle-sway 6s ease-in-out infinite;
  transition: opacity 0.3s ease-out, transform 0.3s ease-out, filter 0.3s ease-out;
}

@keyframes logoFloat {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}

.hero-logo-image {
  width: 220px;
  height: auto;
  filter: drop-shadow(0 5px 15px rgba(0, 0, 0, 0.8));
}

.massage-hero-title {
  font-size: clamp(1.65rem, 4.4vw, 3.3rem);
  font-weight: 900;
  color: var(--spa-gold);
  margin-top: -2.2rem;
  margin-bottom: 0.5rem;
  text-shadow: 
    0 0 40px rgba(212, 175, 55, 0.6),
    0 10px 30px rgba(0, 0, 0, 0.8);
  animation: titleGlow 3s ease-in-out infinite;
}

@keyframes titleGlow {
  0%, 100% {
    text-shadow: 
      0 0 40px rgba(212, 175, 55, 0.6),
      0 10px 30px rgba(0, 0, 0, 0.8);
  }
  50% {
    text-shadow: 
      0 0 60px rgba(212, 175, 55, 0.9),
      0 10px 30px rgba(0, 0, 0, 0.8);
  }
}

.massage-hero-divider {
  width: 120px;
  height: 3px;
  background: linear-gradient(90deg, transparent, var(--spa-gold), transparent);
  margin: 0 auto 0.1rem;
  animation: none;
  display: none;
}

@keyframes dividerExpand {
  0%, 100% {
    width: 120px;
    opacity: 0.8;
  }
  50% {
    width: 160px;
    opacity: 1;
  }
}

.massage-hero-subtitle {
  font-size: clamp(0.85rem, 2vw, 1.2rem);
  color: var(--spa-cream);
  opacity: 0.95;
  max-width: 100%;
  line-height: 1.5;
  text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
  margin-top: -1.2rem;
  animation: fadeInUp 1s ease-out;
  white-space: nowrap;
  overflow: visible;
}

/* Parallax Content */
.massage-parallax-content {
  position: relative;
  z-index: 5;
  margin-top: calc(100vh - 80px);
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.95) 0%,
    #000000 5%,
    #000000 100%
  );
  min-height: 100vh;
  will-change: transform;
  backface-visibility: hidden;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  contain: layout style paint;
  content-visibility: auto;
  transition: transform 0.1s ease-out;
}

/* Services Section with Parallax */
.massage-container .services-section {
  position: relative;
  padding: 6rem 2rem;
  background: #000000;
}

.massage-container .services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  gap: 2rem;
  max-width: 1400px;
  margin: 0 auto;
  animation: fadeInUp 1s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.massage-container .massage-card {
  position: relative;
  background: linear-gradient(
    135deg,
    rgba(212, 175, 55, 0.05) 0%,
    rgba(26, 26, 26, 0.9) 100%
  );
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 20px;
  overflow: hidden;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
              border-color 0.3s ease,
              box-shadow 0.3s ease;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  will-change: transform;
  backface-visibility: hidden;
}

.massage-container .massage-card:hover {
  transform: translateY(-15px) scale(1.02);
  border-color: rgba(212, 175, 55, 0.5);
  box-shadow: 
    0 25px 60px rgba(212, 175, 55, 0.3),
    0 0 40px rgba(212, 175, 55, 0.2);
}

.massage-container .massage-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--spa-gold), #FFA500, var(--spa-gold));
  transform: scaleX(0);
  transition: transform 0.4s ease;
}

.massage-container .massage-card:hover::before {
  transform: scaleX(1);
}

.massage-container .popular-badge {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: linear-gradient(135deg, var(--spa-gold), #FFA500);
  color: var(--spa-dark);
  font-weight: 700;
  padding: 0.5rem 1rem;
  border-radius: 20px;
  font-size: 0.85rem;
  z-index: 10;
  box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
}

.massage-container .massage-name {
  font-size: 1.8rem;
  color: var(--spa-gold);
  margin-bottom: 1rem;
}

.massage-container .massage-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 1rem;
}

.massage-container .duration {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--spa-cream);
  opacity: 0.8;
  font-size: 0.95rem;
}

.massage-container .price {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--spa-gold);
}

.massage-container .massage-description {
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--spa-cream);
  opacity: 0.9;
  margin-bottom: 1.5rem;
}

.massage-container .benefits-list {
  list-style: none;
  padding: 0;
  margin-bottom: 1.5rem;
}

.massage-container .benefits-list li {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--spa-cream);
  opacity: 0.85;
  margin-bottom: 0.5rem;
  font-size: 0.95rem;
}

.massage-container .benefits-list li::before {
  content: '✓';
  color: var(--spa-gold);
  font-weight: bold;
  font-size: 1.1rem;
}

.massage-container .book-button {
  width: 100%;
  background: linear-gradient(135deg, var(--spa-gold), #FFA500);
  color: var(--spa-dark);
  font-weight: 700;
  padding: 1rem;
  border-radius: 10px;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.massage-container .book-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(212, 175, 55, 0.5);
}

/* CTA Section */
.massage-container .cta-section {
  padding: 6rem 2rem;
  background: linear-gradient(
    135deg,
    rgba(212, 175, 55, 0.05) 0%,
    #000000 50%,
    rgba(212, 175, 55, 0.05) 100%
  );
}

.massage-container .cta-content {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
  padding: 4rem 3rem;
  background: linear-gradient(
    135deg,
    rgba(212, 175, 55, 0.08) 0%,
    rgba(15, 15, 15, 0.9) 100%
  );
  border: 2px solid rgba(212, 175, 55, 0.3);
  border-radius: 30px;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
}

.massage-container .cta-title {
  font-size: clamp(2rem, 5vw, 3rem);
  color: var(--spa-gold);
  margin-bottom: 1rem;
}

.massage-container .cta-subtitle {
  font-size: 1.2rem;
  color: var(--spa-cream);
  opacity: 0.9;
  margin-bottom: 2.5rem;
}

.massage-container .cta-buttons {
  display: flex;
  gap: 1.5rem;
  justify-content: center;
  flex-wrap: wrap;
}

.massage-container .cta-button-primary {
  background: linear-gradient(135deg, var(--spa-gold), #FFA500);
  color: var(--spa-dark);
  font-weight: 700;
  padding: 1.2rem 3rem;
  border-radius: 50px;
  transition: all 0.3s ease;
}

.massage-container .cta-button-primary:hover {
  transform: translateY(-3px);
  box-shadow: 0 15px 40px rgba(212, 175, 55, 0.4);
}

.massage-container .cta-button-secondary {
  color: var(--spa-gold);
  border: 2px solid var(--spa-gold);
  padding: 1.2rem 3rem;
  border-radius: 50px;
  transition: all 0.3s ease;
}

.massage-container .cta-button-secondary:hover {
  transform: translateY(-3px);
  background: rgba(212, 175, 55, 0.1);
  box-shadow: 0 15px 40px rgba(212, 175, 55, 0.2);
}

/* Responsive */
/* @media (max-width: 768px) {
  .massage-hero-title {
    font-size: 2.5rem;
  } */

  .hero-logo-image {
    width: 100px;
  }

  .massage-hero-subtitle {
    font-size: 1.1rem;
  }

  .massage-container .services-grid {
    grid-template-columns: 1fr;
  }

  .massage-container .cta-content {
    padding: 3rem 2rem;
  }

  .massage-container .cta-buttons {
    flex-direction: column;
    gap: 1rem;
  }

  .massage-container .cta-button-primary,
  .massage-container .cta-button-secondary {
    width: 100%;
  }
}



/* ============================================
   SPA PAGE - FIXED VIDEO HERO & PARALLAX (Identical to Massage)
   ============================================ */

/* Fixed Video Hero Section */
.spa-hero-fixed {
  position: fixed;
  top: 80px;
  left: 0;
  width: 100%;
  height: calc(100vh - 80px);
  z-index: 0;
  overflow: hidden;
  will-change: transform;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.spa-hero-video-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.spa-hero-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.spa-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.4) 0%,
    rgba(0, 0, 0, 0.7) 100%
  );
  z-index: 1;
}

.spa-hero-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 2rem;
  margin-top: 0;
}

.spa-hero-logo {
  margin-bottom: 1.5rem;
  margin-top: 3.5cm;
  animation: gentle-sway 6s ease-in-out infinite;
  transition: opacity 0.3s ease-out, transform 0.3s ease-out, filter 0.3s ease-out;
}

.spa-hero-title {
  font-size: clamp(1.65rem, 4.4vw, 3.3rem);
  font-weight: 900;
  color: var(--spa-gold);
  margin-top: -2.2rem;
  margin-bottom: 0.5rem;
  text-shadow: 
    0 0 40px rgba(212, 175, 55, 0.6),
    0 10px 30px rgba(0, 0, 0, 0.8);
  animation: titleGlow 3s ease-in-out infinite;
}

.spa-hero-divider {
  width: 120px;
  height: 3px;
  background: linear-gradient(90deg, transparent, var(--spa-gold), transparent);
  margin: 0 auto 0.1rem;
  animation: none;
  display: none;
}

.spa-hero-subtitle {
  font-size: clamp(0.85rem, 2vw, 1.2rem);
  color: var(--spa-cream);
  opacity: 0.95;
  max-width: 100%;
  line-height: 1.5;
  text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
  margin-top: -1.2rem;
  animation: fadeInUp 1s ease-out;
  white-space: nowrap;
  overflow: visible;
}

/* Parallax Content */
.spa-parallax-content {
  position: relative;
  z-index: 5;
  margin-top: calc(100vh - 80px);
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.95) 0%,
    #000000 5%,
    #000000 100%
  );
  min-height: 100vh;
  will-change: transform;
  backface-visibility: hidden;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  contain: layout style paint;
  content-visibility: auto;
  transition: transform 0.1s ease-out;
}

/* Services Section */
.spa-container .services-section {
  position: relative;
  padding: 6rem 2rem;
  background: #000000;
}

.spa-container .services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  gap: 2rem;
  max-width: 1400px;
  margin: 0 auto;
  animation: fadeInUp 1s ease-out;
}

.spa-container .spa-card {
  position: relative;
  background: linear-gradient(
    135deg,
    rgba(212, 175, 55, 0.05) 0%,
    rgba(26, 26, 26, 0.9) 100%
  );
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 20px;
  overflow: hidden;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
              border-color 0.3s ease,
              box-shadow 0.3s ease;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  will-change: transform;
  backface-visibility: hidden;
}

.spa-container .spa-card:hover {
  transform: translateY(-15px) scale(1.02);
  border-color: rgba(212, 175, 55, 0.5);
  box-shadow: 
    0 25px 60px rgba(212, 175, 55, 0.3),
    0 0 40px rgba(212, 175, 55, 0.2);
}

.spa-container .spa-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--spa-gold), #FFA500, var(--spa-gold));
  transform: scaleX(0);
  transition: transform 0.4s ease;
}

.spa-container .spa-card:hover::before {
  transform: scaleX(1);
}

.spa-container .popular-badge {
  background: linear-gradient(135deg, var(--spa-gold), #FFA500);
  color: var(--spa-dark);
  font-weight: 700;
}

.spa-container .category-badge {
  margin-bottom: 1rem;
}

.spa-container .spa-name {
  font-size: 1.8rem;
  color: var(--spa-gold);
}

.spa-container .spa-description {
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--spa-cream);
  opacity: 0.9;
}

/* Responsive */
/* @media (max-width: 768px) {
  .spa-hero-title {
    font-size: 2.5rem;
  } */

  .spa-container .services-grid {
    grid-template-columns: 1fr;
  }
}



/* ========================================
   ABOUT PAGE - FIXED VIDEO HERO STYLE
======================================== */

.about-container {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background: transparent;
  z-index: 50;
}

/* Fixed Video Hero */
.about-hero-fixed {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 1;
  overflow: hidden;
}

.about-hero-video-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.about-hero-video {
  position: absolute;
  top: 50%;
  left: 50%;
  min-width: 100%;
  min-height: 100%;
  width: auto;
  height: auto;
  transform: translate(-50%, -50%);
  object-fit: cover;
  z-index: 0;
}

.about-hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.4) 0%,
    rgba(0, 0, 0, 0.7) 100%
  );
  z-index: 1;
}

.about-hero-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 2rem;
  margin-top: 0;
}

.about-hero-logo {
  margin-bottom: 1.5rem;
  margin-top: 4.6cm;
  animation: gentle-sway 6s ease-in-out infinite;
  transition: opacity 0.3s ease-out, transform 0.3s ease-out, filter 0.3s ease-out;
}

.about-hero-title {
  font-size: clamp(1.65rem, 4.4vw, 3.3rem);
  font-weight: 900;
  color: var(--spa-gold);
  margin-top: -2.2rem;
  margin-bottom: 0.5rem;
  text-shadow: 
    0 0 40px rgba(212, 175, 55, 0.6),
    0 10px 30px rgba(0, 0, 0, 0.8);
  animation: titleGlow 3s ease-in-out infinite;
}

.about-hero-divider {
  width: 120px;
  height: 3px;
  background: linear-gradient(90deg, transparent, var(--spa-gold), transparent);
  margin: 0 auto 0.1rem;
  animation: none;
  display: none;
}

.about-hero-subtitle {
  font-size: clamp(0.85rem, 2vw, 1.2rem);
  color: var(--spa-cream);
  max-width: 100%;
  line-height: 1.5;
  font-weight: 300;
  opacity: 0.95;
  text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
  margin-top: -1.2rem;
  animation: fadeInUp 1s ease-out;
  white-space: nowrap;
  overflow: visible;
}

/* Parallax Content */
.about-parallax-content {
  position: relative;
  z-index: 5;
  margin-top: 100vh;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.95) 0%,
    #000000 5%,
    #000000 100%
  );
  min-height: 100vh;
  transition: transform 0.1s ease-out;
}

/* About Cards Grid - Similar to Massage/Spa */
.about-container .services-section {
  position: relative;
  padding: 6rem 2rem;
  background: #000000;
}

.about-container .services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 2.5rem;
  max-width: 1400px;
  margin: 0 auto;
}

.about-card {
  background: linear-gradient(135deg, rgba(15, 15, 15, 0.95), rgba(25, 25, 25, 0.85));
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 20px;
  padding: 0;
  transition: all 0.4s ease;
  position: relative;
  overflow: hidden;
}

.about-card:hover {
  transform: translateY(-10px);
  border-color: var(--spa-gold);
  box-shadow: 0 20px 60px rgba(212, 175, 55, 0.3);
}

.about-card .about-category {
  margin-bottom: 1rem;
}

.about-card .category-badge {
  display: inline-flex;
  align-items: center;
  padding: 0.6rem 1.2rem;
  font-size: 0.9rem;
  font-weight: 600;
  border-radius: 50px;
  color: white;
  border: none;
}

.about-description {
  font-size: 1.05rem;
  line-height: 1.8;
  color: var(--spa-cream);
  opacity: 0.9;
}

/* Philosophy Quote Section */
.about-philosophy-quote {
  padding: 6rem 2rem;
  background: linear-gradient(180deg, #000000 0%, #0a0a0a 100%);
}

.philosophy-quote-container {
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
  padding: 4rem 3rem;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.08), rgba(212, 175, 55, 0.03));
  border: 2px solid rgba(212, 175, 55, 0.3);
  border-radius: 20px;
}

.philosophy-icon-large {
  width: 60px;
  height: 60px;
  color: var(--spa-gold);
  margin: 0 auto 2rem;
  animation: sparkleRotate 4s linear infinite;
}

/* Philosophy Logo Wrapper and Animation - Same as Contact page */
.philosophy-logo-wrapper {
  width: 200px;
  height: auto;
  margin: 0 auto 2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.philosophy-bua-logo {
  max-width: 200px;
  height: auto;
  filter: drop-shadow(0 5px 15px rgba(0, 0, 0, 0.8));
  animation: gentle-sway 6s ease-in-out infinite;
  position: relative;
  z-index: 2;
}

.philosophy-quote-title {
  font-size: 2.5rem;
  font-weight: 700;
  color: var(--spa-gold);
  margin-bottom: 2rem;
}

.philosophy-quote-text {
  font-size: 1.3rem;
  line-height: 1.9;
  color: var(--spa-cream);
  font-style: italic;
  opacity: 0.95;
  margin-bottom: 2rem;
}

.philosophy-signature {
  margin-top: 2rem;
  padding-top: 2rem;
  border-top: 1px solid rgba(212, 175, 55, 0.3);
}

.philosophy-signature span {
  font-size: 1.1rem;
  color: var(--spa-gold);
  font-weight: 600;
  letter-spacing: 2px;
}

/* Section Styling */
.about-section-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 4rem 2rem;
}

.about-section-label {
  display: inline-block;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--spa-gold);
  letter-spacing: 3px;
  text-transform: uppercase;
  margin-bottom: 1rem;
  border-bottom: 2px solid var(--spa-gold);
  padding-bottom: 0.5rem;
}

.about-section-title {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 700;
  color: var(--spa-gold);
  margin-bottom: 2rem;
  line-height: 1.2;
}

/* Story Section */
.about-story-section {
  padding: 6rem 0;
  background: #000000;
}

.story-text-area {
  max-width: 900px;
  margin: 0 auto;
}

.story-paragraphs {
  margin: 2rem 0 3rem;
}

.story-paragraphs p {
  font-size: 1.15rem;
  line-height: 1.8;
  color: var(--spa-cream);
  margin-bottom: 1.5rem;
  opacity: 0.9;
}

.story-stats-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 2rem;
  margin-top: 3rem;
}

.stat-box {
  text-align: center;
  padding: 2rem;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), rgba(212, 175, 55, 0.05));
  border: 1px solid rgba(212, 175, 55, 0.3);
  border-radius: 12px;
  transition: all 0.3s ease;
}

.stat-box:hover {
  transform: translateY(-5px);
  border-color: var(--spa-gold);
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.15), rgba(212, 175, 55, 0.08));
}

.stat-icon-about {
  width: 40px;
  height: 40px;
  color: var(--spa-gold);
  margin-bottom: 1rem;
}

.stat-number-about {
  font-size: 3rem;
  font-weight: 700;
  color: var(--spa-gold);
  margin-bottom: 0.5rem;
}

.stat-label-about {
  font-size: 1rem;
  color: var(--spa-cream);
  opacity: 0.8;
}

/* Values Section */
.about-values-section {
  padding: 6rem 0;
  background: linear-gradient(180deg, #000000 0%, #0a0a0a 100%);
}

.values-header-about {
  text-align: center;
  margin-bottom: 4rem;
}

.values-description {
  font-size: 1.15rem;
  color: var(--spa-cream);
  opacity: 0.85;
  max-width: 700px;
  margin: 0 auto;
}

.values-grid-about {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 3rem;
  margin-top: 3rem;
}

.value-card-about {
  text-align: center;
  padding: 3rem 2rem;
  background: linear-gradient(135deg, rgba(15, 15, 15, 0.8), rgba(25, 25, 25, 0.6));
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 16px;
  transition: all 0.4s ease;
}

.value-card-about:hover {
  transform: translateY(-10px);
  border-color: var(--spa-gold);
  box-shadow: 0 20px 60px rgba(212, 175, 55, 0.2);
}

.value-icon-circle {
  width: 80px;
  height: 80px;
  margin: 0 auto 2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--spa-gold), #c9a961);
  border-radius: 50%;
  box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
}

.value-icon-about {
  width: 40px;
  height: 40px;
  color: #000000;
}

.value-card-title {
  font-size: 1.8rem;
  font-weight: 600;
  color: var(--spa-gold);
  margin-bottom: 1rem;
}

.value-card-text {
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--spa-cream);
  opacity: 0.85;
}

/* Philosophy Section */
.about-philosophy-section {
  padding: 6rem 0;
  background: #000000;
}

.philosophy-box {
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
  padding: 4rem 3rem;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.08), rgba(212, 175, 55, 0.03));
  border: 2px solid rgba(212, 175, 55, 0.3);
  border-radius: 20px;
  position: relative;
}

.philosophy-sparkle-icon {
  width: 60px;
  height: 60px;
  color: var(--spa-gold);
  margin: 0 auto 2rem;
  animation: sparkleRotate 4s linear infinite;
}

@keyframes sparkleRotate {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.philosophy-quote-title {
  font-size: 2.5rem;
  font-weight: 700;
  color: var(--spa-gold);
  margin-bottom: 2rem;
}

.philosophy-quote-text {
  font-size: 1.3rem;
  line-height: 1.9;
  color: var(--spa-cream);
  font-style: italic;
  opacity: 0.95;
  margin-bottom: 2rem;
}

.philosophy-signature-line {
  margin-top: 2rem;
  padding-top: 2rem;
  border-top: 1px solid rgba(212, 175, 55, 0.3);
}

.signature-text-about {
  font-size: 1.1rem;
  color: var(--spa-gold);
  font-weight: 600;
  letter-spacing: 2px;
}

/* CTA Section */
.about-cta-section {
  padding: 6rem 0;
  background: linear-gradient(180deg, #000000 0%, #0a0a0a 100%);
}

.cta-content-about {
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
}

.cta-title-about {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 700;
  color: var(--spa-gold);
  margin-bottom: 1.5rem;
}

.cta-subtitle-about {
  font-size: 1.3rem;
  color: var(--spa-cream);
  margin-bottom: 3rem;
  opacity: 0.9;
}

.cta-buttons-about {
  display: flex;
  gap: 1.5rem;
  justify-content: center;
  flex-wrap: wrap;
}

.cta-button-primary-about {
  background: linear-gradient(135deg, var(--spa-gold), #c9a961);
  color: #000000;
  padding: 1.2rem 3rem;
  font-size: 1.1rem;
  font-weight: 600;
  border: none;
  border-radius: 50px;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
}

.cta-button-primary-about:hover {
  transform: translateY(-3px);
  box-shadow: 0 15px 40px rgba(212, 175, 55, 0.6);
}

.cta-button-secondary-about {
  background: transparent;
  color: var(--spa-gold);
  padding: 1.2rem 3rem;
  font-size: 1.1rem;
  font-weight: 600;
  border: 2px solid var(--spa-gold);
  border-radius: 50px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.cta-button-secondary-about:hover {
  background: var(--spa-gold);
  color: #000000;
  transform: translateY(-3px);
}

/* Contact & Social Section - Matching Contact Page Style */
/* About page footer - same as Contact page */
.contact-footer {
  background: #1a1a1a;
  padding: 4rem 0 2rem;
  position: relative;
  z-index: 10;
}

.contact-footer-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.contact-footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 4rem;
}

.footer-section {
  display: flex;
  flex-direction: column;
}

.footer-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--spa-gold);
  margin-bottom: 2rem;
}

.footer-items {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.footer-item {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.footer-icon {
  color: var(--spa-gold);
  width: 20px;
  height: 20px;
  flex-shrink: 0;
}

.footer-item a,
.footer-item p {
  color: var(--spa-cream);
  font-size: 1rem;
  text-decoration: none;
  margin: 0;
  transition: color 0.3s ease;
}

.footer-item a:hover {
  color: var(--spa-gold);
}

.footer-social-link {
  display: flex;
  align-items: center;
  gap: 1rem;
  color: var(--spa-cream);
  text-decoration: none;
  transition: color 0.3s ease;
}

.footer-social-link:hover {
  color: var(--spa-gold);
}

/* @media (max-width: 768px) {
  .contact-footer-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  } */
}

.about-contact-social-section {
  padding: 4rem 0 2rem;
  background: #1a1a1a;
  border-top: none;
  position: relative;
  z-index: 10;
}

.about-contact-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  background: #2a2a2a;
  border: 2px solid rgba(212, 175, 55, 0.3);
  backdrop-filter: none;
  border-radius: 15px;
  overflow: hidden;
}

.about-contact-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 3rem;
  padding: 3rem;
}

/* Contact Info Card */
.about-contact-info-card {
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  transition: none;
}

.about-contact-info-card:hover {
  border-color: transparent;
  box-shadow: none;
}

.about-contact-title {
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--spa-gold);
  margin-bottom: 2rem;
  text-align: left;
}

.about-contact-items {
  display: grid;
  gap: 2rem;
}

.about-contact-item {
  display: flex;
  gap: 1rem;
  align-items: center;
  padding: 0;
  background: transparent;
  border-radius: 0;
  transition: none;
}

.about-contact-item:hover {
  background: transparent;
  transform: none;
}

.about-contact-icon {
  width: 20px;
  height: 20px;
  color: var(--spa-gold);
  flex-shrink: 0;
}

.about-info-link {
  color: var(--spa-cream);
  font-size: 1rem;
  text-decoration: none;
  transition: color 0.3s ease;
}

.about-info-link:hover {
  color: var(--spa-gold);
}

.about-info-text {
  color: var(--spa-cream);
  font-size: 1rem;
  line-height: 1.6;
  margin: 0;
}

/* Social Card */
.about-social-card {
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  transition: none;
  border-left: 1px solid rgba(212, 175, 55, 0.2);
  padding-left: 3rem;
}

.about-social-card:hover {
  border-color: rgba(212, 175, 55, 0.2);
  box-shadow: none;
}

.about-social-link {
  display: flex;
  gap: 0.8rem;
  align-items: center;
  text-decoration: none;
  padding: 0;
  background: transparent;
  border-radius: 0;
  transition: none;
}

.about-social-link:hover {
  background: transparent;
  transform: none;
}

.about-social-icon {
  width: 24px;
  height: 24px;
  color: var(--spa-cream);
  transition: none;
  flex-shrink: 0;
}

.about-social-link:hover .about-social-icon {
  transform: none;
}

.about-social-handle {
  color: var(--spa-cream);
  font-size: 1rem;
  margin: 0;
  transition: color 0.3s ease;
}

.about-social-link:hover .about-social-handle {
  color: var(--spa-gold);
}

/* Copyright at bottom */
.about-contact-copyright {
  text-align: center;
  padding: 2rem 0;
  border-top: 1px solid rgba(212, 175, 55, 0.2);
  color: var(--spa-cream);
  font-size: 0.95rem;
  opacity: 0.8;
}

/* Responsive */
/* @media (max-width: 968px) {
  .about-contact-grid {
    grid-template-columns: 1fr;
  } */
  
  .about-social-card {
    border-left: none;
    border-top: 1px solid rgba(212, 175, 55, 0.2);
    padding-left: 0;
    padding-top: 3rem;
    margin-top: 3rem;
  }
}

/* Responsive */
/* @media (max-width: 768px) {
  .about-hero-title {
    font-size: 2.5rem;
  } */

  .story-stats-row {
    grid-template-columns: 1fr;
  }

  .values-grid-about {
    grid-template-columns: 1fr;
  }

  .philosophy-box {
    padding: 3rem 2rem;
  }

  .cta-buttons-about {
    flex-direction: column;
  }
}


/* Simple Parallax Section - About Page */
.about-simple-parallax {
  position: relative;
  z-index: 10;
  width: 100vw;
  min-height: auto;
  background: #000000;
  background-image: url('https://customer-assets.emergentagent.com/job_a9e89e7a-058d-490d-923c-38f5cc2b3a04/artifacts/3888nhn6_Pozadina%20mangala.jpg');
  background-size: 115% 100%;
  background-position: center;
  background-repeat: no-repeat;
  padding: 3rem 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 100vh;
  border-top: 2px solid var(--spa-gold);
  border-bottom: 2px solid var(--spa-gold);
}

.about-simple-parallax::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 0;
}

.about-text-container {
  max-width: 1000px;
  width: 90%;
  margin: 0;
  margin-left: 5%;
  margin-right: 6cm;
  padding: 1.5rem 2rem;
  position: relative;
  z-index: 1;
}

.about-parallax-logo {
  width: 80px;
  height: 80px;
  margin: 0 0 1.5rem 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  filter: drop-shadow(0 8px 20px rgba(212, 175, 55, 0.6));
  animation: logoFloat 3s ease-in-out infinite;
}

.about-parallax-logo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

@keyframes logoFloat {
  0%, 100% {
    transform: translateY(0px);
    filter: drop-shadow(0 8px 20px rgba(212, 175, 55, 0.6));
  }
  50% {
    transform: translateY(-10px);
    filter: drop-shadow(0 15px 30px rgba(212, 175, 55, 0.8));
  }
}

.about-text-paragraph {
  font-size: 1.122rem;
  line-height: 1.8;
  color: #ffffff;
  margin-bottom: 1.2rem;
  text-align: left;
  opacity: 0.95;
  font-weight: 300;
}

.about-intro-highlight {
  color: var(--spa-gold);
  font-size: 1.5rem;
  font-weight: 600;
  text-shadow: 0 2px 8px rgba(212, 175, 55, 0.4);
}

.about-text-paragraph:nth-child(2) {
  padding-left: 0;
}

.about-text-paragraph:nth-child(3) {
  padding-left: 3rem;
}

.about-text-paragraph:nth-child(4) {
  padding-left: 1.5rem;
}

.about-text-paragraph:nth-child(5) {
  padding-left: 4rem;
}

.about-text-paragraph:nth-child(6) {
  padding-left: 2rem;
}

.about-text-paragraph:nth-child(7) {
  padding-left: 0.5rem;
}

.about-text-final {
  color: var(--spa-gold);
  font-size: 1.3rem;
  font-weight: 500;
  margin-top: 3rem;
  margin-bottom: 0;
}

/* Responsive */
/* @media (max-width: 768px) {
  .about-simple-parallax {
    padding: 4rem 0;
    min-height: auto;
  } */
  
  .about-text-container {
    width: 95%;
    padding: 2rem 1rem;
  }
  
  .about-text-paragraph {
    font-size: 1.1rem;
    line-height: 1.7;
  }
  
  .about-text-paragraph:first-child {
    font-size: 1.2rem;
  }
  
  .about-text-final {
    font-size: 1.15rem;
  }
}

/* @media (max-width: 480px) {
  .about-text-paragraph {
    font-size: 1rem;
  } */
  
  .about-text-paragraph:first-child {
    font-size: 1.1rem;
  }
  
  .about-text-final {
    font-size: 1.05rem;
  }
}




/* ============================================
   ADVANCED PARALLAX SCROLLING WITH ANIMATED TEXT ROWS
   ============================================ */

/* Parallax Sections */
.parallax-section {
  position: relative;
  width: 100vw;
  min-height: 120vh;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.parallax-section-1 {
  background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0a0a0a 100%);
  margin-top: 2rem;
}

.parallax-section-2 {
  background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 50%, #1a1a1a 100%);
  margin-top: 4rem;
}

/* Parallax Background Layers */
.parallax-bg-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 120%;
  pointer-events: none;
  will-change: transform;
}

.parallax-bg-1 {
  background: radial-gradient(circle at 20% 30%, rgba(212, 175, 55, 0.1) 0%, transparent 50%);
  z-index: 1;
}

.parallax-bg-2 {
  background: radial-gradient(circle at 80% 70%, rgba(212, 175, 55, 0.05) 0%, transparent 60%);
  z-index: 2;
}

.parallax-bg-3 {
  background: radial-gradient(circle at 60% 20%, rgba(212, 175, 55, 0.08) 0%, transparent 55%);
  z-index: 1;
}

.parallax-bg-4 {
  background: radial-gradient(circle at 30% 80%, rgba(212, 175, 55, 0.06) 0%, transparent 65%);
  z-index: 2;
}

/* Content Wrapper */
.parallax-content-wrapper {
  position: relative;
  z-index: 10;
  width: 100%;
  max-width: 1400px;
  padding: 0 2rem;
}

.parallax-text-container {
  display: flex;
  flex-direction: column;
  gap: 3rem;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

/* Animated Text Rows */
.parallax-text-row {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  will-change: transform, opacity;
  transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Initial positions - OFF SCREEN */
.parallax-text-row.slide-from-left {
  transform: translateX(-100vw);
}

.parallax-text-row.slide-from-right {
  transform: translateX(100vw);
}

/* Active state - SLIDE INTO POSITION */
.parallax-text-row.slide-in-active {
  opacity: 1;
  transform: translateX(0) !important;
}

/* Text Styling */
.parallax-text-line {
  font-size: clamp(2rem, 5vw, 4rem);
  font-weight: 700;
  color: var(--spa-gold);
  text-align: center;
  line-height: 1.2;
  letter-spacing: 0.02em;
  text-shadow: 
    0 0 30px rgba(212, 175, 55, 0.4),
    0 5px 20px rgba(0, 0, 0, 0.8);
  margin: 0;
  padding: 1rem 2rem;
  position: relative;
  z-index: 2;
}

/* Text Glow Effect */
.parallax-text-line::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, transparent 100%);
  border-radius: 10px;
  z-index: -1;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.parallax-text-row.slide-in-active .parallax-text-line::before {
  opacity: 1;
}

/* Staggered Animation Delays */
.parallax-text-row[data-row="1"] {
  transition-delay: 0s;
}

.parallax-text-row[data-row="2"] {
  transition-delay: 0.2s;
}

.parallax-text-row[data-row="3"] {
  transition-delay: 0.4s;
}

.parallax-text-row[data-row="4"] {
  transition-delay: 0.6s;
}

.parallax-text-row[data-row="5"] {
  transition-delay: 0.8s;
}

.parallax-text-row[data-row="6"] {
  transition-delay: 1s;
}

/* Enhanced Text Effects */
.parallax-text-line {
  background: linear-gradient(135deg, var(--spa-gold) 0%, #FFD700 50%, var(--spa-gold) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: textShimmer 3s ease-in-out infinite;
}

@keyframes textShimmer {
  0%, 100% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
}

/* Parallax Section Separators */
.parallax-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--spa-gold), transparent);
  opacity: 0.3;
  z-index: 5;
}

.parallax-section::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--spa-gold), transparent);
  opacity: 0.3;
  z-index: 5;
}

/* Performance Optimizations */
.parallax-section {
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  perspective: 1000px;
  -webkit-perspective: 1000px;
}

.parallax-text-row {
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* Responsive Design */
/* @media (max-width: 1024px) {
  .parallax-section {
    min-height: 100vh;
  } */
  
  .parallax-text-container {
    gap: 2rem;
    min-height: 70vh;
  }
  
  .parallax-text-line {
    font-size: clamp(1.5rem, 4vw, 3rem);
    padding: 0.8rem 1.5rem;
  }
}

/* @media (max-width: 768px) {
  .parallax-section {
    min-height: 90vh;
    padding: 2rem 0;
  } */
  
  .parallax-content-wrapper {
    padding: 0 1rem;
  }
  
  .parallax-text-container {
    gap: 1.5rem;
    min-height: 60vh;
  }
  
  .parallax-text-line {
    font-size: clamp(1.2rem, 3.5vw, 2.5rem);
    padding: 0.6rem 1rem;
    line-height: 1.3;
  }
  
  /* Disable parallax on mobile for better performance */
  .parallax-bg-layer {
    transform: none !important;
  }
}

/* @media (max-width: 480px) {
  .parallax-text-line {
    font-size: clamp(1rem, 3vw, 2rem);
    padding: 0.5rem 0.8rem;
  } */
  
  .parallax-text-container {
    gap: 1rem;
  }
}

/* Accessibility */
/* @media (prefers-reduced-motion: reduce) {
  .parallax-text-row {
    transition: opacity 0.3s ease;
    transform: none !important;
  } */
  
  .parallax-text-row.slide-in-active {
    opacity: 1;
    transform: none !important;
  }
  
  .parallax-bg-layer {
    transform: none !important;
  }
  
  @keyframes textShimmer {
    0%, 100% {
      background-position: 0% 50%;
    }
  }
}

/* High contrast mode support */
/* @media (prefers-contrast: high) {
  .parallax-text-line {
    color: var(--spa-gold);
    -webkit-text-fill-color: var(--spa-gold);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
  } */
}

/* Print styles */
/* @media print {
  .parallax-section {
    position: static;
    height: auto;
    min-height: auto;
    page-break-inside: avoid;
  } */
  
  .parallax-text-row {
    opacity: 1 !important;
    transform: none !important;
  }
  
  .parallax-bg-layer {
    display: none;
  }
}


/* ===== GALLERY PAGE STYLES ===== */

/* Gallery Hero Section - Fixed Background */
.gallery-hero-fixed {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 1;
  overflow: hidden;
}

.gallery-hero-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--spa-dark) 0%, #1a1a1a 100%);
  background-image: url('https://customer-assets.emergentagent.com/job_83ed575e-3634-46be-8586-79a3348def97/artifacts/i03j5uou_podloga.jpg');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
}

.gallery-hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    135deg,
    rgba(10, 10, 10, 0.8) 0%,
    rgba(26, 26, 26, 0.7) 50%,
    rgba(212, 175, 55, 0.1) 100%
  );
}

.gallery-hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100%;
  text-align: center;
  padding: 0 2rem;
}

.gallery-hero-logo {
  margin-bottom: 1.5rem;
  margin-top: 3.5cm;
  animation: gentle-sway 6s ease-in-out infinite;
  transition: opacity 0.3s ease-out, transform 0.3s ease-out, filter 0.3s ease-out;
}

.gallery-hero-logo .hero-logo-image {
  width: 220px;
  height: auto;
  filter: drop-shadow(0 5px 15px rgba(0, 0, 0, 0.8));
}

.gallery-hero-background-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url('https://customer-assets.emergentagent.com/job_a9e89e7a-058d-490d-923c-38f5cc2b3a04/artifacts/a1ydrxis_podloga.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  z-index: 0;
}

.gallery-hero-title {
  font-size: clamp(1.65rem, 4.4vw, 3.3rem);
  font-weight: 900;
  color: var(--spa-gold);
  margin-top: -2.2rem;
  margin-bottom: 0.5rem;
  text-shadow: 
    0 0 40px rgba(212, 175, 55, 0.6),
    0 10px 30px rgba(0, 0, 0, 0.8);
  animation: titleGlow 3s ease-in-out infinite;
}

.gallery-hero-divider {
  width: 120px;
  height: 3px;
  background: linear-gradient(90deg, transparent, var(--spa-gold), transparent);
  margin: 0 auto 0.1rem;
  animation: none;
  display: none;
}

.gallery-hero-subtitle {
  font-size: clamp(0.85rem, 2vw, 1.2rem);
  color: var(--spa-cream);
  opacity: 0.95;
  max-width: 100%;
  line-height: 1.5;
  text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
  margin-top: -1.2rem;
  animation: fadeInUp 1s ease-out;
  white-space: nowrap;
  overflow: visible;
}

/* Gallery Parallax Content Section */
.gallery-parallax-content {
  position: relative;
  z-index: 10;
  margin-top: 100vh;
  width: 100vw;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(10px) saturate(120%);
  -webkit-backdrop-filter: blur(10px) saturate(120%);
  border-top: 2px solid var(--spa-gold);
  border-bottom: 2px solid var(--spa-gold);
  padding: 4rem 0;
}

.gallery-grid-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
}

/* Gallery Row Styling */
.gallery-row {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  margin-bottom: 2rem;
  gap: 1rem;
}

/* Gallery Image Wrapper with Dynamic Positioning */
.gallery-image-wrapper {
  position: relative;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  overflow: hidden;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
}

/* Dynamic sizing and positioning for varied look */
.gallery-image-1 {
  transform: translateY(-30px) translateX(-25px) rotate(-4deg);
  z-index: 4;
  margin-right: -40px;
}

.gallery-image-2 {
  transform: translateY(15px) rotate(2deg);
  z-index: 2;
  margin: 0 -45px;
}

.gallery-image-3 {
  transform: translateY(-20px) translateX(20px) rotate(-6deg);
  z-index: 3;
  margin-left: -35px;
}

/* Gallery Image Styling with Varied Sizes */
.gallery-image {
  object-fit: cover;
  transition: all 0.4s ease;
}

/* Size variations using nth-child for dynamic pattern */
.gallery-row:nth-child(odd) .gallery-image-1 {
  width: 450px;
  height: 320px;
}

.gallery-row:nth-child(odd) .gallery-image-2 {
  width: 250px;
  height: 350px;
}

.gallery-row:nth-child(odd) .gallery-image-3 {
  width: 350px;
  height: 250px;
}

.gallery-row:nth-child(even) .gallery-image-1 {
  width: 320px;
  height: 450px;
}

.gallery-row:nth-child(even) .gallery-image-2 {
  width: 450px;
  height: 320px;
}

.gallery-row:nth-child(even) .gallery-image-3 {
  width: 180px;
  height: 250px;
}

/* Additional rotation variations for more rows */
.gallery-row:nth-child(3n+1) .gallery-image-1 {
  transform: translateY(-25px) translateX(-30px) rotate(3deg);
}

.gallery-row:nth-child(3n+1) .gallery-image-2 {
  transform: translateY(20px) rotate(-5deg);
}

.gallery-row:nth-child(3n+1) .gallery-image-3 {
  transform: translateY(-15px) translateX(25px) rotate(7deg);
}

.gallery-row:nth-child(3n+2) .gallery-image-1 {
  transform: translateY(-35px) translateX(-20px) rotate(-7deg);
}

.gallery-row:nth-child(3n+2) .gallery-image-2 {
  transform: translateY(10px) rotate(4deg);
}

.gallery-row:nth-child(3n+2) .gallery-image-3 {
  transform: translateY(-25px) translateX(30px) rotate(-3deg);
}

/* Image Overlay for Hover Effect */
.gallery-image-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    135deg,
    rgba(212, 175, 55, 0.8) 0%,
    rgba(212, 175, 55, 0.6) 100%
  );
  opacity: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.3s ease;
}

.gallery-image-zoom-icon {
  font-size: 3rem;
  color: white;
  font-weight: bold;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
  transform: scale(0.5);
  transition: all 0.3s ease;
}

/* Enhanced Hover Effects */
.gallery-image-wrapper:hover {
  transform: translateY(-15px) scale(1.08) rotate(0deg) !important;
  box-shadow: 0 20px 50px rgba(212, 175, 55, 0.4);
  z-index: 15 !important;
}

.gallery-image-wrapper:hover .gallery-image-overlay {
  opacity: 1;
}

.gallery-image-wrapper:hover .gallery-image-zoom-icon {
  transform: scale(1);
}

.gallery-image-wrapper:hover .gallery-image {
  transform: scale(1.1);
}

/* Lightbox Styles */
.gallery-lightbox {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.95);
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: fadeIn 0.3s ease;
}

.gallery-lightbox-content {
  position: relative;
  max-width: 90%;
  max-height: 90%;
  animation: zoomIn 0.3s ease;
}

.gallery-lightbox-image {
  max-width: 100%;
  max-height: 80vh;
  object-fit: contain;
  border-radius: 8px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
}

.gallery-lightbox-close {
  position: absolute;
  top: -50px;
  right: -10px;
  background: none;
  border: none;
  color: var(--spa-gold);
  font-size: 3rem;
  cursor: pointer;
  transition: all 0.3s ease;
  z-index: 1001;
}

.gallery-lightbox-close:hover {
  color: white;
  transform: scale(1.2);
}

.gallery-lightbox-caption {
  text-align: center;
  color: var(--spa-cream);
  margin-top: 1rem;
  font-size: 1.1rem;
}

/* Lightbox Animations */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes zoomIn {
  from { 
    opacity: 0;
    transform: scale(0.5);
  }
  to { 
    opacity: 1;
    transform: scale(1);
  }
}

/* Responsive Design */
/* ===== RESPONSIVE GALLERY STYLES ===== */

/* Tablet Landscape - 1024px to 1200px */
/* @media (max-width: 1200px) {
  .gallery-row:nth-child(odd) .gallery-image-1 {
    width: 380px;
    height: 280px;
  } */
  
  .gallery-row:nth-child(odd) .gallery-image-2 {
    width: 220px;
    height: 300px;
  }
  
  .gallery-row:nth-child(odd) .gallery-image-3 {
    width: 300px;
    height: 220px;
  }
  
  .gallery-row:nth-child(even) .gallery-image-1 {
    width: 280px;
    height: 380px;
  }
  
  .gallery-row:nth-child(even) .gallery-image-2 {
    width: 380px;
    height: 280px;
  }
  
  .gallery-row:nth-child(even) .gallery-image-3 {
    width: 160px;
    height: 220px;
  }
  
  .gallery-image-2 {
    margin: 0 -35px;
  }
}

/* Tablet Portrait - 768px to 1024px */
/* @media (max-width: 1024px) {
  .gallery-hero-logo {
    width: 180px;
    margin-top: 2.5cm;
    margin-bottom: 1rem;
  } */
  
  .gallery-hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }
  
  .gallery-hero-subtitle {
    font-size: clamp(0.85rem, 1.8vw, 1.1rem);
    padding: 0 2rem;
    white-space: normal !important;
  }
  
  .gallery-row {
    gap: 0.8rem;
  }
  
  .gallery-row:nth-child(odd) .gallery-image-1 {
    width: 320px;
    height: 240px;
  }
  
  .gallery-row:nth-child(odd) .gallery-image-2 {
    width: 180px;
    height: 260px;
  }
  
  .gallery-row:nth-child(odd) .gallery-image-3 {
    width: 260px;
    height: 180px;
  }
  
  .gallery-row:nth-child(even) .gallery-image-1 {
    width: 240px;
    height: 320px;
  }
  
  .gallery-row:nth-child(even) .gallery-image-2 {
    width: 320px;
    height: 240px;
  }
  
  .gallery-row:nth-child(even) .gallery-image-3 {
    width: 140px;
    height: 200px;
  }
  
  .gallery-image-1 {
    margin-right: -30px;
    transform: translateY(-20px) translateX(-15px) rotate(-3deg);
  }
  
  .gallery-image-2 {
    margin: 0 -30px;
  }
  
  .gallery-image-3 {
    margin-left: -25px;
    transform: translateY(-15px) translateX(15px) rotate(-4deg);
  }
}

/* Mobile Landscape & Tablet Small - 600px to 768px */
/* @media (max-width: 768px) {
  .gallery-hero-logo {
    width: 160px;
    margin-top: 2cm;
    margin-bottom: 0.8rem;
  } */
  
  .gallery-hero-title {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  
  .gallery-hero-subtitle {
    font-size: clamp(0.75rem, 1.5vw, 0.95rem);
    padding: 0 1.5rem;
    white-space: normal !important;
    line-height: 1.4;
  }
  
  .gallery-row {
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }
  
  .gallery-image-wrapper {
    transform: none !important;
    margin: 0 !important;
  }
  
  .gallery-image {
    width: 90vw !important;
    max-width: 400px !important;
    height: auto !important;
    aspect-ratio: 4/3 !important;
  }
  
  .gallery-parallax-content {
    padding: 2rem 0;
  }
  
  .gallery-grid-container {
    padding: 0 1rem;
  }
  
  .gallery-image-overlay {
    background: linear-gradient(
      135deg,
      rgba(212, 175, 55, 0.85) 0%,
      rgba(212, 175, 55, 0.7) 100%
    );
  }
  
  .gallery-image-zoom-icon {
    font-size: 2.5rem;
  }
}

/* Mobile Portrait - 480px to 600px */
/* @media (max-width: 600px) {
  .gallery-hero-logo {
    width: 140px;
    margin-top: 1.5cm;
  } */
  
  .gallery-hero-title {
    font-size: clamp(1.8rem, 4.5vw, 2.5rem);
  }
  
  .gallery-hero-subtitle {
    font-size: clamp(0.7rem, 1.3vw, 0.85rem);
    padding: 0 1rem;
  }
  
  .gallery-image {
    width: 92vw !important;
    max-width: 350px !important;
  }
}

/* Mobile Small - up to 480px */
/* @media (max-width: 480px) {
  .gallery-hero-logo {
    width: 120px;
    margin-top: 1.2cm;
  } */
  
  .gallery-hero-title {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
  }
  
  .gallery-hero-subtitle {
    font-size: clamp(0.65rem, 1.2vw, 0.8rem);
    padding: 0 0.8rem;
  }
  
  .gallery-image {
    width: 95vw !important;
    max-width: 320px !important;
  }
  
  .gallery-grid-container {
    padding: 0 0.5rem;
  }
  
  .gallery-lightbox-close {
    top: -40px;
    right: 0;
    font-size: 2.5rem;
  }
  
  .gallery-image-zoom-icon {
    font-size: 2rem;
  }
}

/* ===== END GALLERY PAGE STYLES ===== */

